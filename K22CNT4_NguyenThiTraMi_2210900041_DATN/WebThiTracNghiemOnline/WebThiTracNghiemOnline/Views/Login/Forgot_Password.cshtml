
@{
    ViewBag.Title = "Forgot_Password";
    Layout = "~/Views/Shared/_LayoutLogin.cshtml";
}

<main class="login-body">

    <div class="login-form">
        <!-- logo-login -->
        <div class="logo-login">
            <img src="~/Theme/img/logo/logoschool.png" alt="">
        </div>
        <h2>Quên mật khẩu</h2>
        <h3 style="color:powderblue"> Điền thông tin vào form. Sau đó hệ thống sẽ gửi thông báo về gmail tiến hành đổi mật khẩu.</h3>
        @using (Html.BeginForm("Forgot_Password", "Login", FormMethod.Post, new { @class = "form-horizontal" }))
        {
            @Html.AntiForgeryToken()
            <div class="form-input">
                <label for="name">Tài khoản</label>
                <input type="text" value="" name="Username">
            </div>
            <div class="form-input">
                <label for="name">Email</label>
                <input type="email" value="" name="Email">
            </div>
            <div class="form-input pt-30">
                <input type="submit" name="submit" value="Gửi">
            </div>
            if (!String.IsNullOrEmpty(ViewBag.ErrorMessage))
            {
                <div class="alert alert-danger mt-3">@ViewBag.ErrorMessage</div>
            }
            if (!String.IsNullOrEmpty(ViewBag.Message))
            {
                <div class="alert alert-success mt-3">@ViewBag.Message</div>
            }
        }
        <a href="@Url.Action("LoginUser","Login")" class="forget">Trở về đăng nhập?</a>
    </div>

</main>

