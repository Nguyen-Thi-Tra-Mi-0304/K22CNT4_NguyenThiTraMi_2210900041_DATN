@{
    ViewBag.Title = "Forgot_Password";
    Layout = "~/Views/Shared/_LayoutLogin.cshtml";
}

<main class="login-body">

    <div class="login-form">
        <!-- logo-login -->
        <div class="logo-login">
            <img src="~/Theme/img/logo/logoschool.png" alt="">
        </div>
        <h2>Đặt lại mật khẩu</h2>
        @using (Html.BeginForm("Reset_Password", "Login", FormMethod.Post, new { @class = "form-horizontal" }))
        {
            @Html.AntiForgeryToken()
            <input type="hidden" name="token" value="@ViewBag.Token" />

            <!-- Mật khẩu mới -->
            <div class="form-input">
                <label for="newPassword">Mật khẩu mới</label>
                <div class="password-field d-flex">
                    <input type="password" name="newPassword" id="newPassword" required />
                </div>
            </div>

            <!-- Nhập lại mật khẩu -->
            <div class="form-input">
                <label for="confirmPassword">Nhập lại mật khẩu</label>
                <div class="password-field d-flex">
                    <input type="password" name="confirmPassword" id="confirmPassword" required />
                </div>
            </div>

            <div class="form-input pt-30">
                <input type="submit" name="submit" value="Đặt lại mật khẩu" class="btn-custom" />
            </div>

            if (!String.IsNullOrEmpty(ViewBag.ErrorMessage))
            {
                <div class="alert alert-danger mt-3">@ViewBag.ErrorMessage</div>
            }
            if (!String.IsNullOrEmpty(ViewBag.Message))
            {
                <div class="alert alert-success mt-3">@ViewBag.Message</div>
            }
        }
    </div>
</main>

