<style>
    /* Định dạng bảng */
    #calendar-container {
        padding: 20px;
        display: flex;
        justify-content: center;
    }

    #calendar {
        width: 75%;
        border-collapse: collapse;
        background-color: rgba(255, 255, 255, 0.9); /* Nền bảng mờ để nổi bật */
        color: #333; /* Màu chữ chính */
        border-radius: 10px;
        overflow: hidden;
    }

        #calendar th, #calendar td {
            border: 1px solid rgba(0, 0, 0, 0.1); /* Đường viền nhạt */
            text-align: center;
            vertical-align: top;
            padding: 10px;
        }

        #calendar th {
            background: #ffffff; /* Gradient phần đầu bảng */
            color: black;
            font-weight: bold;
        }

        #calendar td {
            background-color: #ffffff;
            height: 100px;
            position: relative;
            color: #333;
        }

    /* Định dạng ngày hiện tại */
    .calendar-day.today {
        background-color: rgba(255, 223, 107, 0.8); /* Màu vàng nhạt */
        border: 2px solid #ffcc00;
    }

    /* Số ngày trong lịch */
    .date-number {
        font-weight: bold;
        font-size: 16px;
        position: absolute;
        top: 5px;
        right: 5px;
        color: #333;
    }

    /* Danh sách bài thi */
    .calendar-day ul {
        list-style: none;
        margin-top: 15px;
        padding: 0;
    }

        .calendar-day ul li {
            font-size: 14px;
            margin: 5px 0;
            padding: 5px;
            border-radius: 5px;
            font-weight: bold;
        }

            /* Trạng thái bài thi */
            .calendar-day ul li.exam-not-started {
                background-color: rgba(255, 255, 153, 0.8); /* Màu vàng nhạt */
                color: black;
                border: 1px solid #ff9900;
            }

            .calendar-day ul li.exam-in-progress {
                background-color: rgba(76, 175, 80, 0.8); /* Màu xanh lá nhạt */
                color: white;
                border: 1px solid #4caf50;
            }

            .calendar-day ul li.exam-completed {
                background-color: rgba(244, 67, 54, 0.8); /* Màu đỏ nhạt */
                color: white;
                border: 1px solid #f44336;
            }

    /* Tiêu đề ngày giờ */
    #current-date-time {
        background: linear-gradient(to right, #c054ff, #5274ff);
        color: white;
        padding: 10px;
        font-size: 18px;
        font-weight: bold;
        border-radius: 10px 10px 0 0;
    }

    /* Hiệu ứng hover cho ô lịch */
    #calendar td:hover {
        background-color: rgba(200, 200, 255, 0.5); /* Màu nhấn nhạt */
        cursor: pointer;
    }
</style>



