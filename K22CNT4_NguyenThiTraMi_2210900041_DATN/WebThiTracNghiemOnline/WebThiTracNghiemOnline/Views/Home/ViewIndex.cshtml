<!--? About Area-3 Start -->
<section class="about-area1 fix pt-10">
    <div id="calendar-container" style="padding: 20px; display:flex; justify-content:center">
        <table id="calendar" border="1" cellspacing="0" cellpadding="10" style="width: 75%; border-collapse: collapse;">
            <thead>
                <tr class="calendar1">
                    <th colspan="7" style="text-align: center; font-size: 18px; padding: 10px; background: linear-gradient(to right, #5274ff, #c054ff);" id="current-date-time">
                        <!-- Nội dung sẽ được JavaScript cập nhật -->
                    </th>
                </tr>
                <tr>
                    <th>Chủ nhật</th>
                    <th>Thứ hai</th>
                    <th>Thứ ba</th>
                    <th>Thứ tư</th>
                    <th>Thứ năm</th>
                    <th>Thứ sáu</th>
                    <th>Thứ bảy</th>
                </tr>
            </thead>
            <tbody>
                @{
                    var exams = ViewBag.Exams as List<WebThiTracNghiemOnline.Models.ExamModel>;
                    var daysInMonth = DateTime.DaysInMonth(DateTime.Now.Year, DateTime.Now.Month);
                    var firstDay = new DateTime(DateTime.Now.Year, DateTime.Now.Month, 1).DayOfWeek;
                    int day = 1 - (int)firstDay;

                    // Cờ dừng khi tất cả các ngày đã được hiển thị
                    bool stopRendering = false;

                    for (int week = 0; week < 6; week++)
                    {
                        if (stopRendering)
                        {
                            break; // Đặt trong dấu {}
                        }

                        <tr>
                            @for (int weekday = 0; weekday < 7; weekday++)
                            {
                                if (day < 1 || day > daysInMonth)
                                {
                                    <td></td>
                                }
                                else
                                {
                                    var currentDate = new DateTime(DateTime.Now.Year, DateTime.Now.Month, day);
                                    var examsOnDay = exams.Where(e => e.DateTime.Date == currentDate.Date).ToList();

                                    <td class="calendar-day @(currentDate.Date == DateTime.Now.Date ? "today" : "")">
                                        <div class="date-number">@day</div>

                                        @if (examsOnDay != null && examsOnDay.Any())
                                        {
                                            <ul>
                                                @foreach (var exam in examsOnDay)
                                                {
                                                    // Tính toán trạng thái bài thi
                                                    var examStartTime = exam.DateTime;
                                                    var examEndTime = examStartTime.AddMinutes(exam.ASSIGNMENTTIME);
                                                    string examStatusClass;
                                                    string examStatusText;

                                                    if (exam.Status == 1)
                                                    {
                                                        examStatusClass = "exam-not-started";
                                                        examStatusText = "Chưa bắt đầu";
                                                    }
                                                    else if (exam.Status == 2)
                                                    {
                                                        examStatusClass = "exam-in-progress";
                                                        examStatusText = "Đang làm bài";
                                                    }
                                                    else
                                                    {
                                                        examStatusClass = "exam-completed";
                                                        examStatusText = "Đã kết thúc";
                                                    }

                                                    // Hiển thị bài thi với trạng thái
                                                    <li class="@examStatusClass">
                                                        <strong>@exam.SubjectName</strong> - @exam.NameExam<br />
                                                        @exam.DateTime.ToString("hh:mm tt") - @exam.ASSIGNMENTTIME phút<br />
                                                        <span>Trạng thái: @examStatusText</span>
                                                    </li>
                                                }
                                            </ul>
                                        }
                                    </td>
                                }

                                day++;
                                if (day > daysInMonth)
                                {
                                    stopRendering = true;
                                }
                            }
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</section>

<script>
    // Hàm để cập nhật thời gian hiện tại
    function updateDateTime() {
        const element = document.getElementById('current-date-time');

        // Lấy ngày giờ hiện tại
        const now = new Date();

        // Mảng các thứ trong tuần bằng tiếng Việt
        const days = ["Chủ nhật", "Thứ hai", "Thứ ba", "Thứ tư", "Thứ năm", "Thứ sáu", "Thứ bảy"];

        // Định dạng thời gian
        const day = days[now.getDay()];
        const date = now.getDate().toString().padStart(2, '0');
        const month = (now.getMonth() + 1).toString().padStart(2, '0'); // Tháng bắt đầu từ 0
        const year = now.getFullYear();
        const hours = now.getHours().toString().padStart(2, '0');
        const minutes = now.getMinutes().toString().padStart(2, '0');
        const seconds = now.getSeconds().toString().padStart(2, '0');

        // Gộp chuỗi ngày giờ
        const formattedDateTime = `${day}, ${date}/${month}/${year} ${hours}:${minutes}:${seconds}`;

        // Cập nhật nội dung cho thẻ
        element.textContent = formattedDateTime;
    }

    // Cập nhật thời gian mỗi giây
    setInterval(updateDateTime, 1000);

    // Gọi hàm lần đầu để hiển thị ngay khi tải trang
    updateDateTime();</script>