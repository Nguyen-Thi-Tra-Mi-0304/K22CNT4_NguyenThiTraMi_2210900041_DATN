
@model WebThiTracNghiemOnline.Models.AccountStudents

@{
    ViewBag.Title = "PesionalInfo";
    Layout = "~/Views/Shared/_LayoutNoBanner.cshtml";
    var classes = ViewBag.Classes as List<dynamic>;
}

<!-- Bootstrap CSS -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha3/dist/css/bootstrap.min.css" rel="stylesheet">

<!-- jQuery (nếu dùng Bootstrap 4 trở xuống) -->
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

<!-- Bootstrap JS -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha3/dist/js/bootstrap.bundle.min.js"></script>

<style>
    .form-control {
        font-size: 2rem;
    }

    .a {
        text-decoration: none;
    }
</style>


<div class="courses-area section-padding40 fix">
    <div class="container">
        <!-- Breadcrumb -->
        <div class="properties" style="font-size:20px;">
            <img src="~/Theme/img/icon/home-button.png" alt="" style="width: 25px; height: 25px; margin-bottom: 5px;">
            <a href="@Url.Action("ViewIndex", "Home")">Trang chủ </a> /
            <a href="#">Thông tin cá nhân</a>
        </div>

        <!-- Tab Header -->
        <div class="properties pb-20">
            <div class="properties__card">
                <div class="properties__caption ">
                    <h2 class="text-primary text-center" style="font-size:35px; margin-bottom:20px;">Quản lý thông tin cá nhân</h2>

                    <!-- Tab Navigation -->
                    <ul class="nav nav-tabs" style="margin-bottom: 20px;font-size:2rem;">
                        <li class="nav-item">
                            <a class="nav-link active " data-bs-toggle="tab" href="#tab1">Thông tin học sinh</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link " data-bs-toggle="tab" href="#tab2">Đổi mật khẩu</a>
                        </li>
                    </ul>
                    <!-- Tab Content -->
                    <div class="tab-content">
                        <!-- Tab 1 Content -->

                        <div class="tab-pane fade show active" id="tab1">
                            <div class="exam-details" style="font-size:2rem; line-height:1.8;">
                                @using (Html.BeginForm("UpdateStudentInfo", "Information", FormMethod.Post, new { enctype = "multipart/form-data" }))
                                {
                                    @Html.AntiForgeryToken()
                                    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                                    <div class="row">
                                        <!-- Cột bên trái -->
                                        <div class="col-md-4">
                                            <div class="text-center mb-4 position-relative">
                                                <label for="imageUpload" class="cursor-pointer">
                                                    <img id="previewImage"
                                                         src="~/Theme/img/Info/@(Model.IMAGE ?? "img_user.png")"
                                                         alt="Ảnh đại diện"
                                                         class="rounded-circle"
                                                         style="width: 150px; height: 150px; object-fit: cover;">
                                                </label>
                                                <i class="fas fa-camera position-absolute text-primary"
                                                   style="bottom: 10px; font-size: 20px; cursor: pointer;"
                                                   onclick="document.getElementById('imageUpload').click();"></i>

                                                <input type="file" id="imageUpload" name="imageUpload" class="d-none" accept="image/*" onchange="previewSelectedImage(event)">
                                            </div>
                                            <input type="hidden" id="StudentId" name="StudentId" value="@Model.ID" />

                                            <div class="mb-3">
                                                @Html.LabelFor(model => model.NAMESTUDENT, "Họ và tên", new { @class = "form-label" })
                                                @Html.EditorFor(model => model.NAMESTUDENT, new { htmlAttributes = new { @class = "form-control" } })
                                            </div>

                                            <div class="mb-3">
                                                @Html.LabelFor(model => model.SEX, "Giới tính", new { @class = "form-label" })
                                                @Html.DropDownListFor(model => model.SEX,
                                                    new SelectList(new List<SelectListItem>
                                                    {
                                                        new SelectListItem { Text = "Nam", Value = "Nam" },
                                                        new SelectListItem { Text = "Nữ", Value = "Nữ" }
                                                    }, "Value", "Text", Model.SEX),
                                                    "Chọn giới tính",
                                                    new { @class = "form-control" })
                                            </div>

                                            <div class="mb-3">
                                                @Html.LabelFor(model => model.BIRTHDAY, "Ngày sinh", new { @class = "form-label" })
                                                @Html.TextBoxFor(model => model.BIRTHDAY, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
                                            </div>

                                            <div class="mb-3">
                                                @Html.LabelFor(model => model.EMAIL, "Email", new { @class = "form-label" })
                                                @Html.EditorFor(model => model.EMAIL, new { htmlAttributes = new { @class = "form-control" } })
                                            </div>

                                            <div class="mb-2 d-flex justify-content-end">
                                                <button type="submit" class=" btn-primary gj-font-size-16">Cập nhật</button>
                                            </div>
                                        </div>
                                        <!-- Cột bên phải -->
                                        <div class="col-md-8">
                                            <div class="row mb-3 border-bottom-1">
                                                <div class="col-md-6">
                                                    @Html.LabelFor(model => model.IDINDUSTRY, "Ngành", new { @class = "form-label" })
                                                    @Html.DropDownListFor(model => model.IDINDUSTRY, (SelectList)ViewBag.Industry,
                                             new { @class = "form-control", @disabled = "disabled" })
                                                    @Html.ValidationMessageFor(model => model.IDINDUSTRY, "", new { @class = "text-danger" })
                                                </div>

                                                <div class="col-md-6">
                                                    @Html.LabelFor(model => model.IDCOURSE, "Khóa học", new { @class = "form-label" })
                                                    @Html.DropDownListFor(model => model.IDCOURSE, (SelectList)ViewBag.Course,
                                             new { @class = "form-control", @disabled = "disabled" })
                                                    @Html.ValidationMessageFor(model => model.IDCOURSE, "", new { @class = "text-danger" })
                                                </div>
                                                <div class="col-md-6">
                                                    @Html.LabelFor(model => model.ACCOUNT, "Tài khoản", new { @class = "form-label" })
                                                    @Html.EditorFor(model => model.ACCOUNT, new { htmlAttributes = new { @class = "form-control", @disabled = "disabled" } })
                                                    @Html.ValidationMessageFor(model => model.ACCOUNT, "", new { @class = "text-danger" })
                                                </div>
                                                <div class="col-md-6">
                                                    @Html.LabelFor(model => model.ROLE, "Vai trò", new { @class = "form-label" })
                                                    <input type="text" class="form-control"
                                                           value="@(Model.ROLE == 3 ? "Học sinh" : "Vai trò khác")"
                                                           readonly />
                                                    @Html.HiddenFor(model => model.ROLE)
                                                </div>

                                            </div>
                                            <hr />
                                            <div class="row mb-3">
                                                <h2>Những lớp học đã tham gia</h2>
                                                <ul>
                                                    @foreach (var item in (IEnumerable<dynamic>)ViewBag.Class)
                                                    {
                                                        <li>
                                                            <a class="text-decoration-none" href="#"><b>Lớp:</b> @item.NAMECLASS (@item.KEYCLASS) - <b>Giáo viên:</b> @item.TeacherName</a>
                                                        </li>
                                                    }
                                                </ul>
                                            </div>

                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                        <!-- Tab 2 Content -->
                        <div class="tab-pane fade" id="tab2">
                            <div class="exam-details" style="font-size:18px; line-height:1.8;display:flex; flex-direction:column;align-items:center">
                                <div class="form-group col-md-6">
                                    <label for="currentPassword"><strong>Mật khẩu hiện tại:</strong></label>
                                    <input type="password" class="form-control" id="currentPassword" name="currentPassword" required>
                                </div>
                                <div class="form-group col-md-6">
                                    <label for="newPassword"><strong>Mật khẩu mới:</strong></label>
                                    <input type="password" class="form-control" id="newPassword" name="newPassword" required>
                                </div>
                                <div class="form-group col-md-6">
                                    <label for="confirmPassword"><strong>Xác nhận mật khẩu mới:</strong></label>
                                    <input type="password" class="form-control" id="confirmPassword" name="confirmPassword" required>
                                </div>
                                <div class="start-exam-btn col-md-3" style="margin-top:20px;">
                                    <button id="btnChangePassword" class="border-btn border-btn2" type="submit">Đổi mật khẩu</button>
                                </div>
                            </div>
                        </div>
                    </div> <!-- End Tab Content -->
                </div>
            </div>
        </div>
    </div>
</div>

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" />
<script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>

<script>
    $(document).ready(function () {
        // Submit form bằng AJAX
        $('form').on('submit', function (e) {
            e.preventDefault();

            var formData = new FormData(this);

            $.ajax({
                url: $(this).attr('action'),
                type: $(this).attr('method'),
                data: formData,
                contentType: false,
                processData: false,
                success: function (response) {
                    if (response.success) {
                        toastr.success(response.message);
                    } else {
                        toastr.error(response.message);
                    }
                },
                error: function () {
                    toastr.error("Đã xảy ra lỗi trong quá trình cập nhật.");
                }
            });
        });
    });


    function previewSelectedImage(event) {
        var reader = new FileReader();
        reader.onload = function () {
            var previewImage = document.getElementById('previewImage');
            previewImage.src = reader.result;
        };
        reader.readAsDataURL(event.target.files[0]);
    }

    $(document).ready(function () {
        $("#btnChangePassword").on("click", function (e) {
            e.preventDefault();
            var formData = {
                currentPassword: $("#currentPassword").val(),
                newPassword: $("#newPassword").val(),
                confirmPassword: $("#confirmPassword").val(),
            };
            $.ajax({
                url: '@Url.Action("ChangePassword", "Information")',
                type: "POST",
                contentType: "application/x-www-form-urlencoded; charset=UTF-8",
                data: formData,
                success: function (response) {
                    if (response.success) {
                        toastr.success(response.message);
                        $("#currentPassword").val("");
                        $("#newPassword").val("");
                        $("#confirmPassword").val("");
                    } else {
                        toastr.error(response.message);
                    }
                },
                error: function (xhr, status, error) {
                    // Xử lý lỗi AJAX
                    console.error("Lỗi:", error);
                    alert("Đã xảy ra lỗi, vui lòng thử lại.");
                }
            });
        });
    });

</script>


