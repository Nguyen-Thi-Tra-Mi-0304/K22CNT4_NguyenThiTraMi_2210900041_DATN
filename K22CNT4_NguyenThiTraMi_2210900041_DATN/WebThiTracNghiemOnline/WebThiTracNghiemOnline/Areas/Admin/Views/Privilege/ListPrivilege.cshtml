@model IEnumerable<WebThiTracNghiemOnline.Models.Privilege>

@{
    ViewBag.Title = "ListPrivilege";
    Layout = "~/Areas/Admin/Views/Shared/LayoutAdmin.cshtml";
}

<div class="page-inner">
    <div class="row">
        <div class="col-md-12">
            <div class="card">
                <div class="card-header">
                    <div class="d-flex align-items-center">
                        <h4 class="card-title">Danh sách ngành nghề</h4>
                        <button class="btn btn-primary btn-round ms-auto" onclick="location.href='@Url.Action("CreatePrivilege","Privilege")'">
                            <i class="fa fa-plus"></i>
                            Thêm mới
                        </button>
                    </div>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table id="multi-filter-select" class="table table-striped table-bordered" style="text-align:center">
                            <thead>
                                <tr role="row">
                                    <th>
                                        Mã quyền
                                    </th>
                                    <th>
                                        Tên quyền
                                    </th>
                                    <th>
                                        Mô tả
                                    </th>
                                    <th>
                                        Ngày tạo
                                    </th>
                                    <th>
                                        Trạng thái
                                    </th>
                                    <th>
                                        Hành động
                                    </th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td>
                                            @Html.DisplayFor(modelItem => item.ID)
                                        </td>
                                        <td>
                                            @Html.DisplayFor(modelItem => item.NAME)
                                        </td>
                                        <td>
                                            @Html.DisplayFor(modelItem => item.DISCRIBLE)
                                        </td>
                                        <td>
                                            @Html.DisplayFor(modelItem => item.CREATEAT)
                                        </td>
                                        @if (item.STT == 1)
                                        {
                                            <td style="color:forestgreen">
                                                Hoạt động
                                            </td>
                                        }
                                        else
                                        {
                                            <td style="color:red">
                                                Không hoạt động
                                            </td>
                                        }

                                        <td style="text-align:center">
                                            <button type="button" class="btn btn-primary" onclick="location.href='@Url.Action("EditPrivilege", new { id = item.ID })'"><i class="fa fa-edit"></i></button>
                                            <button type="button" id="xoatintucmodalt" class="btn btn-warning" onclick="confirmDelete('@Url.Action("DeleteIndustry", "Industry", new { id = item.ID })')"><i class="fa fa-trash"></i></button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script type="text/javascript">
    function confirmDelete(deleteUrl) {
        if (confirm("Bạn có chắc chắn muốn xóa ngành này?")) {
            $.ajax({
                url: deleteUrl,
                type: "POST",
                success: function (response) {
                    if (response.success) {
                        toastr.success(response.message);
                        setTimeout(function () {
                            location.reload();
                        }, 1500);
                    } else {
                        toastr.error(response.message);
                        setTimeout(function () {
                            location.reload();
                        }, 1500);
                    }
                },
                error: function () {
                    toastr.error("Đã xảy ra lỗi khi xóa ngành này.");
                }
            });
        }
    }
</script>
