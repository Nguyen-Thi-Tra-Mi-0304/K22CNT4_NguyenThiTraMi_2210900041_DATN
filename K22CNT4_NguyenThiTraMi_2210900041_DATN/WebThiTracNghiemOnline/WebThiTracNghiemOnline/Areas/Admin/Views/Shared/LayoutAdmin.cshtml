<!DOCTYPE html>
<html lang="en">
<head>
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <title>Khoa CNTT - ĐH Nguyễn Trãi</title>
    <meta content="width=device-width, initial-scale=1.0, shrink-to-fit=no"
          name="viewport" />
    <link rel="icon"
          href="~/Theme/img/logo/logoschool.png"
          type="image/x-icon" />

    <!-- Fonts and icons -->
    <script src="~/Areas/Admin/Data/js/plugin/webfont/webfont.min.js"></script>
    <script>
        WebFont.load({
            google: { families: ["Public Sans:300,400,500,600,700"] },
            custom: {
                families: [
                    "Font Awesome 5 Solid",
                    "Font Awesome 5 Regular",
                    "Font Awesome 5 Brands",
                    "simple-line-icons",
                ],
                urls: ["~/Areas/Admin/Data/css/fonts.min.css"],
            },
            active: function () {
                sessionStorage.fonts = true;
            },
        });</script>

    <!-- CSS Files -->
    <link rel="stylesheet" href="~/Areas/Admin/Data/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/Areas/Admin/Data/css/plugins.min.css" />
    <link rel="stylesheet" href="~/Areas/Admin/Data/css/kaiadmin.min.css" />

    <!-- CSS Just for demo purpose, don't include it in your project -->
    <link rel="stylesheet" href="~/Areas/Admin/Data/css/demo.css" />
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <!-- Thêm Toastr CSS và JavaScript -->

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" />

    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/js/toastr.min.js"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/css/toastr.min.css" rel="stylesheet" />

    <script type="text/javascript">
        function KeepSessionAlive() {
            $.ajax({
                url: '@Url.Action("KeepSessionAlive", "Login")',
                method: 'GET',
                success: function (result) {
                    console.log("Session refreshed");
                },
                error: function (xhr, status, error) {
                    if (xhr.status === 404) {
                        console.log("Resource not found: " + xhr.responseText);
                    } else if (xhr.status === 401) {
                        alert("Session has expired. Please log in again.");
                        window.location.href = '/Login/Login';
                    } else {
                        console.log("Error refreshing session: " + error);
                    }
                }
            });
        }
        setInterval(KeepSessionAlive, 60000); // 60000ms = 1 phút
    </script>
</head>
<body>
    <div class="wrapper">
        <!-- Sidebar -->
        <div class="sidebar" data-background-color="dark">
            <div class="sidebar-logo">
                <!-- Logo Header -->
                <div class="logo-header" data-background-color="dark">
                    <a href="@Url.Action("HomePage","HomePage")" class="logo">
                        <img src="~/Theme/img/logo/logomain.png"
                             alt="navbar brand"
                             class="navbar-brand"
                             style="width:150px;height:auto;" />
                    </a>
                    <div class="nav-toggle">
                        <button class="btn btn-toggle toggle-sidebar">
                            <i class="gg-menu-right"></i>
                        </button>
                        <button class="btn btn-toggle sidenav-toggler">
                            <i class="gg-menu-left"></i>
                        </button>
                    </div>
                    <button class="topbar-toggler more">
                        <i class="gg-more-vertical-alt"></i>
                    </button>
                </div>
                <!-- End Logo Header -->
            </div>
            <div class="sidebar-wrapper scrollbar scrollbar-inner">
                <div class="sidebar-content">
                    <ul class="nav nav-secondary">
                        @if (Session["UserRole"] != null)
                        {
                            if (Session["UserRole"].ToString() == "Admin" || Session["UserRole"].ToString() == "Teacher")
                            {

                                <li class="nav-item active">
                                    <a href="@Url.Action("HomePage", "HomePage")" class="collapsed">
                                        <i class="fas fa-home"></i>
                                        <p>Trang chủ</p>
                                    </a>
                                </li>
                            }
                            if (Session["UserRole"].ToString() == "Admin")
                            {
                                <li class="nav-item">
                                    <a href="@Url.Action("ListAccoutAdmin", "AccountUser")">
                                        <i class="fas fa-layer-group"></i>
                                        <p>Giáo viên</p>
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a href="@Url.Action("ListStudent", "AccountUser")">
                                        <i class="fas fa-layer-group"></i>
                                        <p>Học sinh</p>
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a href="@Url.Action("ListIndustry", "Industry")">
                                        <i class="fas fa-layer-group"></i>
                                        <p>Ngành nghề</p>
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a href="@Url.Action("ListCourse", "Industry")">
                                        <i class="fas fa-layer-group"></i>
                                        <p>Khóa học</p>
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a href="@Url.Action("ListSemester", "Industry")">
                                        <i class="fas fa-layer-group"></i>
                                        <p>Học kỳ</p>
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a href="@Url.Action("ListSubject", "Subject")">
                                        <i class="fas fa-layer-group"></i>
                                        <p>Môn học</p>
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a href="@Url.Action("ListClass", "Class")">
                                        <i class="fas fa-layer-group"></i>
                                        <p>Lớp học</p>
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a href="@Url.Action("ListPrivilege", "Privilege")">
                                        <i class="fas fa-layer-group"></i>
                                        <p>Phân quyền</p>
                                    </a>
                                </li>
                            }
                            if (Session["UserRole"].ToString() == "Teacher")
                            {

                                <li class="nav-item">
                                    <a href="@Url.Action("ListSubjectByIdTeacher", "Chapter")">
                                        <i class="fas fa-layer-group"></i>
                                        <p>Môn học & chương</p>
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a href="@Url.Action("CreateQuestions", "Questions")">
                                        <i class="fas fa-layer-group"></i>
                                        <p>Câu hỏi</p>
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a href="@Url.Action("ListClassToTeacher", "ClassToTeacher")">
                                        <i class="fas fa-layer-group"></i>
                                        <p>Lớp học</p>
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a href="@Url.Action("ListExam", "Exam")">
                                        <i class="fas fa-layer-group"></i>
                                        <p>Đề thi</p>
                                    </a>
                                </li>
                            }
                        }
                    </ul>
                </div>
            </div>
        </div>
        <!-- End Sidebar -->
        <div class="main-panel">
            <div class="main-header">
                <!-- Navbar Header -->
                <nav class="navbar navbar-header navbar-header-transparent navbar-expand-lg border-bottom">
                    <div class="container-fluid">
                        <ul class="navbar-nav topbar-nav ms-md-auto align-items-center">
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle profile-pic" href="#" id="navbarDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <span class="profile-username">
                                        <span class="fw-bold">
                                            @if (Session["UserName"] != null)
                                            {
                                                var user = (WebThiTracNghiemOnline.Models.AccountUser)Session["UserName"];
                                                @:Xin chào, @user.NAMEUSER
                                            }
                                            else
                                            {
                                                @:User
                                            }
                                        </span>
                                    </span>
                                </a>
                                <ul class="dropdown-menu" aria-labelledby="navbarDropdown">
                                    <li><a class="dropdown-item" href="#">Trang cá nhân</a></li>
                                    <li><a class="dropdown-item" href="@Url.Action("ChangePassword","HomePage")">Đổi mật khẩu</a></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li><a class="dropdown-item" href="@Url.Action("Logout","Login")">Đăng xuất</a></li>
                                </ul>
                            </li>
                        </ul>

                    </div>
                </nav>
            </div>
            <div class="container">
                @RenderBody()
            </div>
        </div>


        <!-- End Custom template -->
        <!--   Core JS Files   -->
        <script src="~/Areas/Admin/Data/js/core/jquery-3.7.1.min.js"></script>
        <script src="~/Areas/Admin/Data/js/core/popper.min.js"></script>
        @*<script src="~/Areas/Admin/Data/js/core/bootstrap.min.js"></script>*@

        <!-- jQuery Scrollbar -->
        <script src="~/Areas/Admin/Data/js/plugin/jquery-scrollbar/jquery.scrollbar.min.js"></script>

        <!-- Chart JS -->
        <script src="~/Areas/Admin/Data/js/plugin/chart.js/chart.min.js"></script>

        <!-- jQuery Sparkline -->
        <script src="~/Areas/Admin/Data/js/plugin/jquery.sparkline/jquery.sparkline.min.js"></script>

        <!-- Chart Circle -->
        <script src="~/Areas/Admin/Data/js/plugin/chart-circle/circles.min.js"></script>

        <!-- Datatables -->
        <script src="~/Areas/Admin/Data/js/plugin/datatables/datatables.min.js"></script>

        <!-- Bootstrap Notify -->
        @*<script src="~/Areas/Admin/Data/js/plugin/bootstrap-notify/bootstrap-notify.min.js"></script>*@

        <!-- jQuery Vector Maps -->
        <script src="~/Areas/Admin/Data/js/plugin/jsvectormap/jsvectormap.min.js"></script>
        <script src="~/Areas/Admin/Data/js/plugin/jsvectormap/world.js"></script>

        <!-- Sweet Alert -->
        <script src="~/Areas/Admin/Data/js/plugin/sweetalert/sweetalert.min.js"></script>

        <!-- Kaiadmin JS -->
        <script src="~/Areas/Admin/Data/js/kaiadmin.min.js"></script>

        <script>
            $(document).ready(function () {
                $("#basic-datatables").DataTable({});

                $("#multi-filter-select").DataTable({
                    pageLength: 5,
                    initComplete: function () {
                        this.api()
                            .columns()
                            .every(function () {
                                var column = this;
                                var select = $(
                                    '<select class="form-select"><option value=""></option></select>'
                                )
                                    .appendTo($(column.footer()).empty())
                                    .on("change", function () {
                                        var val = $.fn.dataTable.util.escapeRegex($(this).val());

                                        column
                                            .search(val ? "^" + val + "$" : "", true, false)
                                            .draw();
                                    });

                                column
                                    .data()
                                    .unique()
                                    .sort()
                                    .each(function (d, j) {
                                        select.append(
                                            '<option value="' + d + '">' + d + "</option>"
                                        );
                                    });
                            });
                    },
                });

                // Add Row
                $("#add-row").DataTable({
                    pageLength: 5,
                });

                var action =
                    '<td> <div class="form-button-action"> <button type="button" data-bs-toggle="tooltip" title="" class="btn btn-link btn-primary btn-lg" data-original-title="Edit Task"> <i class="fa fa-edit"></i> </button> <button type="button" data-bs-toggle="tooltip" title="" class="btn btn-link btn-danger" data-original-title="Remove"> <i class="fa fa-times"></i> </button> </div> </td>';

                $("#addRowButton").click(function () {
                    $("#add-row")
                        .dataTable()
                        .fnAddData([
                            $("#addName").val(),
                            $("#addPosition").val(),
                            $("#addOffice").val(),
                            action,
                        ]);
                    $("#addRowModal").modal("hide");
                });
            });
        </script>
</body>
</html>
