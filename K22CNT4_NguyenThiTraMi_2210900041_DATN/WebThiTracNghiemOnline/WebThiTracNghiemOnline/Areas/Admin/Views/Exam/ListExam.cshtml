@model IEnumerable<WebThiTracNghiemOnline.Models.Exam>

@{
    ViewBag.Title = "ListExam";
    Layout = "~/Areas/Admin/Views/Shared/LayoutAdmin.cshtml";
}
<style>
    .switch {
        --_size: var(--size, 3rem);
        --_padding: var(--padding, 0.2rem);
        --on-color: oklch(67.81% 0.178 146.32);
        --off-color: white;
        --bg-color: oklch(86.6% 0.007 247.9);
        --block-size: calc(var(--_size) / 1.7);
        input

    {
        inline-size: 0;
        block-size: 0;
        display: none;
    }

    > label {
        inline-size: var(--_size);
        block-size: var(--block-size);
        cursor: pointer;
        text-indent: -9999px;
        background-color: var(--bg-color);
        display: block;
        border-radius: 100px;
        position: relative;
    }

    label:after {
        inline-size: calc(var(--block-size) - (var(--_padding) * 2));
        block-size: calc(var(--block-size) - (var(--_padding) * 2));
        content: '';
        position: absolute;
        inset-block-start: var(--_padding);
        inset-inline-start: var(--_padding);
        background: var(--off-color);
        border-radius: 50rem;
        transition: 0.3s;
    }

    input:checked + label {
        background-color: var(--on-color);
    }

        input:checked + label:after {
            left: calc(100% - var(--_padding));
            transform: translateX(-100%);
        }
    }
</style>

<div class="page-inner">
    <div class="row">
        <div class="col-md-12">
            <div class="card">
                <div class="card-header">
                    <div class="d-flex align-items-center">
                        <h4 class="card-title">Danh sách bài thi</h4>
                        <button class="btn btn-primary btn-round ms-auto" onclick="location.href='@Url.Action("CreateExam","Exam")'">
                            <i class="fa fa-plus"></i>
                            Thêm mới
                        </button>
                    </div>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table id="multi-filter-select" class="table table-striped table-bordered" style="text-align:center">
                            <thead>
                                <tr>
                                    <th>
                                        Môn học
                                    </th>
                                    <th>
                                        Lớp
                                    </th>
                                    <th>
                                        Tên bài thi
                                    </th>
                                    <th>
                                        Số lượng câu hỏi
                                    </th>
                                    <th>
                                        Thời gian làm bài
                                    </th>
                                    <th>
                                        Số lần làm bài
                                    </th>
                                    <th>
                                        Mật khẩu bài thi
                                    </th>
                                    <th>
                                        Trạng thái
                                    </th>
                                    <th style="text-align:center">
                                        Hành động
                                    </th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td>
                                            @((ViewBag.Mon as SelectList).FirstOrDefault(s => s.Value == item.IDSUBJECT.ToString())?.Text)
                                        </td>
                                        <td>
                                            @((ViewBag.Lop as SelectList).FirstOrDefault(s => s.Value == item.IDCLASS.ToString())?.Text)
                                        </td>
                                        <td>
                                            @Html.DisplayFor(modelItem => item.NAMEEXAM)
                                        </td>
                                        <td>
                                            @ViewBag.QuestionCounts[item.IDEXAM] câu
                                        </td>
                                        <td>
                                            @Html.DisplayFor(modelItem => item.ASSIGNMENTTIME) phút
                                        </td>
                                        <td>
                                            @Html.DisplayFor(modelItem => item.NUMBER) lần
                                        </td>
                                        <td>
                                            @Html.DisplayFor(modelItem => item.PASSWORD)
                                        </td>
                                        @if (item.STATUS == 1)
                                        {
                                            <td>
                                                Chưa bắt đầu
                                            </td>
                                        }
                                        else if (item.STATUS == 2)
                                        {
                                            <td style="color: forestgreen">
                                                Đang làm
                                            </td>
                                        }
                                        else
                                        {
                                            <td style="color:red">
                                                Đã kết thúc
                                            </td>
                                        }
                                        <td style="text-align:center">
                                            <button type="button" class="btn btn-success" data-bs-toggle="modal" data-id="@item.IDEXAM" data-bs-target="#settingsModal" onclick="loadExamSettings('@item.IDEXAM')"><i class="fa fa-cog"></i> </button>
                                            <button type="button" class="btn btn-primary" onclick="location.href='@Url.Action("EditExam","Exam", new { idExam = item.IDEXAM })'"><i class="fa fa-edit"></i></button>
                                            <button type="button" class="btn btn-info" onclick="location.href='@Url.Action("DetailsExam", new { id = item.IDEXAM })'"><i class="fa fa-info-circle"></i></button>
                                            <button type="button" id="xoatintucmodalt" class="btn btn-warning" onclick="confirmDelete('@Url.Action("DeleteThongBao", "MainAdmin", new { id = item.IDEXAM })')"><i class="fa fa-trash"></i></button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@*// Model settingExam*@

<!-- Modal -->
<div class="modal fade" id="settingsModal" tabindex="-1" aria-labelledby="settingsModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="settingsModalLabel">Quản lý các tùy chọn</h5>
            </div>
            <div class="modal-body">
                <input type="hidden" id="exam-id" />
                <!-- Nội dung của modal -->
                <div class="form-check d-flex align-items-end">
                    <div class="switch">
                        <input type="checkbox" id="switch1" />
                        <label for="switch1"></label>
                    </div>
                    <label class="form-check-label" style="margin-left:10px" for="switch1">
                        Trộn câu hỏi
                    </label>
                </div>
                <div class="form-check d-flex align-items-end">
                    <div class="switch">
                        <input type="checkbox" id="switch2" />
                        <label for="switch2"></label>
                    </div>
                    <label class="form-check-label" style="margin-left:10px" for="switch2">
                        Trộn đáp án
                    </label>
                </div>
                <div class="form-check d-flex align-items-end">
                    <div class="switch">
                        <input type="checkbox" id="switch3" />
                        <label for="switch3"></label>
                    </div>
                    <label class="form-check-label" style="margin-left:10px" for="switch3">
                        Hiển thị điểm số khi làm xong
                    </label>
                </div>
                <div class="form-check d-flex align-items-end">
                    <div class="switch">
                        <input type="checkbox" id="switch4" />
                        <label for="switch4"></label>
                    </div>
                    <label class="form-check-label" style="margin-left:10px" for="switch4">
                        Hiển thị kết quả sau khi làm xong
                    </label>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                <button type="button" class="btn btn-primary" data-bs-dismiss="modal" id="saveChangesButtonSetting">Lưu thay đổi</button>
            </div>
        </div>
    </div>
</div>

<script>
    function loadExamSettings(examId) {
        $.ajax({
            url: '@Url.Action("GetExamSettings", "Exam")',
            type: 'GET',
            data: { id: examId },
            success: function (data) {
                $('#exam-id').val(data.id);
                $('#switch1').prop('checked', data.randomQuestions);
                $('#switch2').prop('checked', data.randomAnswers);
                $('#switch3').prop('checked', data.showScore);
                $('#switch4').prop('checked', data.showResult);
            },
            error: function () {
                alert("Lỗi khi tải dữ liệu.");
            }
        });
    }

    $('#saveChangesButtonSetting').click(function () {
    var examId = $('#exam-id').val();
    var mixQuestions = $('#switch1').is(':checked');
    var mixAnswers = $('#switch2').is(':checked');
    var showScore = $('#switch3').is(':checked');
    var showResult = $('#switch4').is(':checked');

    $.ajax({
        url: '@Url.Action("SaveExamSettings", "Exam")',
        type: 'POST',
        data: {
            id: examId,
            mixQuestions: mixQuestions,
            mixAnswers: mixAnswers,
            showScore: showScore,
            showResult: showResult
        },
        success: function (data) {
            toastr.success('Lưu thay đổi thành công!', '', { timeOut: 2000 });
            $('#settingsModal').modal('hide');
        },
        error: function () {
            alert('Lỗi khi lưu thay đổi');
        }
    });
});
</script>