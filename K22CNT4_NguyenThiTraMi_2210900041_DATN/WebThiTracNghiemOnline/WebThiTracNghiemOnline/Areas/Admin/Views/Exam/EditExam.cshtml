@model WebThiTracNghiemOnline.Models.EditExamViewModel

@{
    ViewBag.Title = "EditExam";
    Layout = "~/Areas/Admin/Views/Shared/LayoutAdmin.cshtml";
}


<div class="page-inner">
    <div class="row">
        <!-- Form tìm kiếm -->
        <div class="col-md-12">
            <div class="card">
                <div class="card-header">
                    <div class="d-flex align-items-center">
                        <h4 class="card-title">Chỉnh sửa bài thi</h4>
                    </div>
                </div>
                <div class="card-body">
                    <div class="row">
                        <input type="text" class="form-control" id="idExam" value="@Model.Exam.IDEXAM" hidden >
                        <div class="col-sm-12 col-md-4">
                            <div class="form-group">
                                @Html.DropDownList("subjectSelect", (SelectList)Model.SubjectList, "Chọn môn học", new { id = "subjectSelect", @class = "form-control", @disabled = "disabled" })
                            </div>
                        </div>
                        <div class="col-sm-12 col-md-4">
                            <div class="form-group">
                                @Html.DropDownList("semesterSelect", (SelectList)Model.SemesterList, "Chọn học kỳ", new { id = "semesterSelect", @class = "form-control", @disabled = "disabled" })
                            </div>
                        </div>
                        <div class="col-sm-12 col-md-4">
                            <div class="form-group">
                                @Html.DropDownList("classSelect", (SelectList)Model.ClassList, "Chọn lớp", new { id = "classSelect", @class = "form-control", @disabled = "disabled" })
                            </div>
                        </div>
                        <div class="col-sm-12 col-md-4">
                            <div class="form-group">
                                <input type="text" class="form-control" id="nameexam" value="@Model.Exam.NAMEEXAM" placeholder="Tên bài thi">
                            </div>
                        </div>
                        <div class="col-sm-12 col-md-8">
                            <div class="form-group">
                                <input type="text" class="form-control" id="discribeexam" value="@Model.Exam.DESCRIBLE" placeholder="Mô tả bài thi">
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-12">
                <div class="card">
                    <div class="col-md-12">
                        <div class="card-header">
                            <h4 class="card-title">Cập nhật câu hỏi cho bài thi</h4>
                        </div>
                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-6 col-lg-4">
                                    <div class="form-group">
                                        <label>Chọn chương</label>
                                        <select id="chapterSelect" class="form-control" disabled>
                                            <option value="" disabled selected hidden>Chọn chương</option>
                                        </select>
                                    </div>
                                    <!-- Hiển thị số lượng câu hỏi theo cấp độ -->
                                    <div class="form-group">
                                        <label>Số lượng câu hỏi có trong ngân hàng:</label>
                                        <div class="row">
                                            <div class="col-lg-4">
                                                <label for="easyQuestions">Dễ</label>
                                                <input type="number" class="form-control" id="easyQuestions" readonly>
                                            </div>
                                            <div class="col-lg-4">
                                                <label for="mediumQuestions">Trung bình</label>
                                                <input type="number" class="form-control" id="mediumQuestions" readonly>
                                            </div>
                                            <div class="col-lg-4">
                                                <label for="hardQuestions">Khó</label>
                                                <input type="number" class="form-control" id="hardQuestions" readonly>
                                            </div>
                                        </div>
                                    </div>
                                    <!-- Nhập số lượng câu hỏi mong muốn cho từng cấp độ -->
                                    <div class="form-group">
                                        <form id="questionSelectionForm">
                                            <label>Nhập số lượng câu hỏi mong muốn cho từng cấp độ:</label>
                                            <div class="row">
                                                <div class="form-group col-lg-4">
                                                    <label for="easyQuestionsInput">Dễ</label>
                                                    <input type="number" class="form-control" id="easyQuestionsInput" min="0" value="">
                                                </div>
                                                <div class="form-group col-lg-4">
                                                    <label for="mediumQuestionsInput">Trung bình</label>
                                                    <input type="number" class="form-control" id="mediumQuestionsInput" min="0" value="">
                                                </div>
                                                <div class="form-group col-lg-4">
                                                    <label for="hardQuestionsInput">Khó</label>
                                                    <input type="number" class="form-control" id="hardQuestionsInput" min="0" value="">
                                                </div>
                                            </div>
                                        </form>
                                        <div class="row">
                                            <div class="form-group col-lg-6">
                                                <button type="button" class="btn btn-warning form-control" onclick="generateQuestions()">Tạo câu hỏi thủ công</button>
                                            </div>
                                            <div class="form-group col-lg-6">
                                                <button type="button" class="btn btn-primary form-control" onclick="generateRandomQuestions()">Tạo câu hỏi ngẫu nhiên</button>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <label for="date-checkin">Chọn ngày bắt đầu</label>
                                        <input type="datetime-local" id="date-checkin" class="form-control" value="@Model.Exam.CREATESTART.ToString("yyyy-MM-ddTHH:mm")">
                                    </div>
                                    <div class="form-group">
                                        <label for="date-checkout">Chọn ngày kết thúc</label>
                                        <input type="datetime-local" id="date-checkout" class="form-control" value="@Model.Exam.CREATEEND.ToString("yyyy-MM-ddTHH:mm")">
                                    </div>
                                    <div class="form-group d-flex align-items-center">
                                        <label class="mr-3 mb-0" style="width: 40%;">Thời gian làm bài (phút)</label>
                                        <input type="number" class="form-control w-75" id="timetoexam" value="@Model.Exam.ASSIGNMENTTIME">
                                    </div>
                                    <div class="form-group d-flex align-items-center">
                                        <label class="mr-3 mb-0" style="width: 40%;">Số lần làm bài (lần)</label>
                                        <input type="number" class="form-control w-75" id="attempts" value="@Model.Exam.NUMBER">
                                    </div>
                                    <div class="form-group d-flex align-items-center">
                                        <label class="mr-3 mb-0" style="width: 40%;">Mật khẩu</label>
                                        <input type="password" id="password" class="form-control w-75" value="@Model.Exam.PASSWORD">
                                    </div>
                                    <div class="row">
                                        <div class="form-group col-lg-6">
                                            <button class="btn btn-warning form-control" onclick="location.href='@Url.Action("ListExam", "Exam")'">
                                                Trở về
                                            </button>
                                        </div>
                                        <div class="form-group col-lg-6">
                                            <button type="button" class="btn btn-success form-control" onclick="submitExam()">Cập nhật bài thi</button>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6 col-lg-8">
                                    <div class="mt-4">
                                        <h5 style="font-weight:800">Danh sách câu hỏi hiện tại trong bài thi</h5>
                                        <label id="questionCountLabel">
                                            Số lượng câu hỏi hiện tại: @Model.SelectedQuestions.Count()
                                        </label>
                                        <div class="table-responsive">
                                            <table id="multi-filter-select" class="table table-striped table-bordered" style="text-align:center">
                                                <thead>
                                                    <tr role="row">
                                                        <th>SỐ THỨ TỰ</th>
                                                        <th>ĐỘ KHÓ</th>
                                                        <th>NỘI DUNG CÂU HỎI</th>
                                                        <th>ĐÁP ÁN ĐÚNG</th>
                                                        <th>LOẠI CÂU HỎI</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @if (Model.SelectedQuestions != null && Model.SelectedQuestions.Any())
                                                    {
                                                        int index = 1;
                                                        foreach (var question in Model.SelectedQuestions)
                                                        {
                                                            <tr>
                                                                <td>@index</td>
                                                                <td>@question.Difficulty</td>
                                                                <td>@question.QuestionText</td>
                                                                <td>@string.Join(" || ", question.CorrectAnswersTextList)</td>
                                                                <td>@question.QuestionType</td>
                                                            </tr>
                                                            index++;
                                                        }
                                                    }
                                                    else
                                                    {
                                                        <tr>
                                                            <td colspan="5">Không có câu hỏi nào</td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


<script>
    $(document).ready(function() {
            var $chapterSelect = $('#chapterSelect');
            $('#subjectSelect').change(function() {
                var subjectId = $(this).val();
                if (subjectId) {
                    $.ajax({
                        url: '@Url.Action("GetChaptersBySubject", "Exam")',
                        type: 'GET',
                        dataType: 'json',
                        data: { subjectId: subjectId },
                        success: function(data) {
                            $chapterSelect.empty();
                            $.each(data, function(index, chapter) {
                                $chapterSelect.append('<option value="' + chapter.ID + '">' + chapter.Name + '</option>');
                            });
                            $chapterSelect.trigger('change');
                        },
                        error: function(xhr, status, error) {
                            console.log('Error: ' + error);
                        }
                    });
                } else {
                    $chapterSelect.empty();
                    $('#easyQuestions').val('');
                    $('#mediumQuestions').val('');
                    $('#hardQuestions').val('');
                }
            });
            $chapterSelect.change(function() {
                var subjectId = $('#subjectSelect').val();
                var chapterId = $(this).val();

                $.ajax({
                    url: '@Url.Action("GetQuestionCounts", "Exam")',
                    type: 'GET',
                    dataType: 'json',
                    data: { subjectId: subjectId, chapterId: chapterId },
                    success: function(data) {
                        $('#easyQuestions').val(data.easy);
                        $('#mediumQuestions').val(data.medium);
                        $('#hardQuestions').val(data.hard);
                    },
                    error: function(xhr, status, error) {
                        console.log('Error: ' + error);
                    }
                });
            });
            $('#subjectSelect').trigger('change');
    });

    function submitExam() {
    var id = $('#idExam').val();
    var name = $('#nameexam').val();
    var discrible = $('#discribeexam').val();
    var timestart = $('#date-checkin').val();
    var timeend = $('#date-checkout').val();
    var time = $('#timetoexam').val();
    var solan = $('#attempts').val();
    var password = $('#password').val();

    var examData = {
        ID: id,
        NAMEEXAM: name,
        DESCRIBLE: discrible,
        TIMESTART: timestart,
        TIMEEND: timeend,
        TIME: time,
        SOLAN: solan,
        PASSWORD: password
    };

    $.ajax({
        url: '@Url.Action("UpdateExam", "Exam")',
        type: 'POST',
        data: examData,
        success: function(response) {
            if (response.success) {
                toastr.success('Sửa bài thi thành công!', '', { timeOut: 2000 });
                window.location.href = '@Url.Action("ListExam", "Exam")';
            } else {
                alert("Cập nhật bài thi thất bại.");
            }
        },
        error: function() {
            alert("Có lỗi xảy ra khi cập nhật bài thi.");
        }
    });
}
</script>
