
@{
    ViewBag.Title = "CreateExam";
    Layout = "~/Areas/Admin/Views/Shared/LayoutAdmin.cshtml";
}

<div class="page-inner">
    <div class="row">
        <!-- Form tìm kiếm -->
        <div class="col-md-12">
            <div class="card">
                <div class="card-header">
                    <div class="d-flex align-items-center">
                        <h4 class="card-title">Tạo đề thi</h4>
                    </div>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-sm-12 col-md-4">
                            <div class="form-group">
                                @Html.DropDownList("subjectSelect", (SelectList)ViewBag.Subject, "Chọn môn học", new { id = "subjectSelect", @class = "form-control" })
                            </div>
                        </div>
                        <div class="col-sm-12 col-md-4">
                            <div class="form-group">
                                @Html.DropDownList("semesterSelect", (SelectList)ViewBag.Semester, "Chọn học kỳ", new { id = "semesterSelect", @class = "form-control" })
                            </div>
                        </div>
                        <div class="col-sm-12 col-md-4">
                            <div class="form-group">
                                @Html.DropDownList("classSelect", (SelectList)ViewBag.Class, "Chọn lớp", new { id = "classSelect", @class = "form-control" })
                            </div>
                        </div>
                        <div class="col-sm-12 col-md-4">
                            <div class="form-group">
                                <input type="text" class="form-control" id="nameexam" placeholder="Tên bài thi">
                            </div>
                        </div>
                        <div class="col-sm-12 col-md-8">
                            <div class="form-group">
                                <input type="text" class="form-control" id="discribeexam" placeholder="Mô tả bài thi">
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-12">
                <div class="card">
                    <div class="col-md-12">
                        <div class="card-header">
                            <h4 class="card-title">Thêm câu hỏi vào bài thi</h4>
                        </div>
                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-6 col-lg-4">
                                    <div class="form-group">
                                        <label>Chọn chương</label>
                                        <select id="chapterSelect" class="form-control">
                                            <option value="" disabled selected hidden>Chọn chương</option>
                                        </select>
                                    </div>
                                    <!-- Hiển thị số lượng câu hỏi theo cấp độ -->
                                    <div class="form-group">
                                        <label>Số lượng câu hỏi có trong ngân hàng:</label>
                                        <div class="row">
                                            <div class="col-lg-4">
                                                <label for="easyQuestions">Dễ</label>
                                                <input type="number" class="form-control" id="easyQuestions" readonly>
                                            </div>
                                            <div class="col-lg-4">
                                                <label for="mediumQuestions">Trung bình</label>
                                                <input type="number" class="form-control" id="mediumQuestions" readonly>
                                            </div>
                                            <div class="col-lg-4">
                                                <label for="hardQuestions">Khó</label>
                                                <input type="number" class="form-control" id="hardQuestions" readonly>
                                            </div>
                                        </div>
                                    </div>
                                    <!-- Nhập số lượng câu hỏi mong muốn cho từng cấp độ -->
                                    <div class="form-group">
                                        <form id="questionSelectionForm">
                                            <label>Nhập số lượng câu hỏi mong muốn cho từng cấp độ:</label>
                                            <div class="row">
                                                <div class="form-group col-lg-4">
                                                    <label for="easyQuestionsInput">Dễ</label>
                                                    <input type="number" class="form-control" id="easyQuestionsInput" min="0" value="">
                                                </div>
                                                <div class="form-group col-lg-4">
                                                    <label for="mediumQuestionsInput">Trung bình</label>
                                                    <input type="number" class="form-control" id="mediumQuestionsInput" min="0" value="">
                                                </div>
                                                <div class="form-group col-lg-4">
                                                    <label for="hardQuestionsInput">Khó</label>
                                                    <input type="number" class="form-control" id="hardQuestionsInput" min="0" value="">
                                                </div>
                                            </div>
                                        </form>
                                        <div class="row">
                                            <div class="form-group col-lg-6">
                                                <button type="button" class="btn btn-warning form-control" onclick="generateQuestions()">Tạo câu hỏi thủ công</button>

                                            </div>
                                            <div class="form-group col-lg-6">
                                                <button type="button" class="btn btn-primary form-control" onclick="generateRandomQuestions()">Tạo câu hỏi ngẫu nhiên</button>
                                            </div>
                                        </div>

                                    </div>
                                    <div class="form-group">
                                        <label for="date-checkin">Chọn ngày bắt đầu</label>
                                        <input type="datetime-local" id="date-checkin" class="form-control">
                                    </div>
                                    <div class="form-group">
                                        <label for="date-checkout">Chọn ngày kết thúc</label>
                                        <input type="datetime-local" id="date-checkout" class="form-control">
                                    </div>
                                    <div class="form-group d-flex align-items-center">
                                        <label class="mr-3 mb-0" style="width: 40%;">Thời gian làm bài (phút)</label>
                                        <input type="number" class="form-control w-75" id="timetoexam">
                                    </div>
                                    <div class="form-group d-flex align-items-center">
                                        <label class="mr-3 mb-0" style="width: 40%;">Số lần làm bài (lần)</label>
                                        <input type="number" class="form-control  w-75" id="attempts">
                                    </div>
                                    <div class="form-group d-flex align-items-center">
                                        <label class="mr-3 mb-0" style="width: 40%;">Mật khẩu</label>
                                        <input type="password" id="password" class="form-control  w-75">
                                    </div>
                                    <div class="row">
                                        <div class="form-group col-lg-6">
                                            <button class="btn btn-warning form-control" onclick="location.href='@Url.Action("ListExam","Exam")'">
                                                <i class="fa fa-home"></i>    Trở về
                                            </button>
                                        </div>
                                        <div class="form-group col-lg-6">
                                            <button type="button" class="btn btn-success form-control" onclick="submitExam()"><i class="fa fa-plus"></i>Tạo bài thi</button>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6 col-lg-8 ">
                                    <div id="questionList" class="mt-4">
                                        <h5 style="font-weight:800">Danh sách câu hỏi được tạo từ ngân hàng câu hỏi</h5>
                                        <label id="questionCountLabel">Số lượng câu hỏi đã được tạo: 0</label>
                                        <div class="table-responsive" id="generatedQuestionList">
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


<!-- Modal để hiển thị danh sách câu hỏi -->
<div id="questionsModal" class="modal fade" tabindex="-1" role="dialog" aria-labelledby="questionsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl" role="document">
        <!-- Thêm 'modal-lg' để mở rộng modal -->
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="questionsModalLabel">Danh sách câu hỏi</h5>
            </div>
            <div class="modal-body">
                <div class="table-responsive">
                    <table id="multi-filter-select" class="table table-striped table-bordered" style="text-align:center">
                        <thead>
                            <tr>
                                <th>Chọn</th>
                                <th>Mã câu hỏi</th>
                                <th>Câu hỏi</th>
                                <th>Độ khó</th>
                                <th>Loại câu hỏi</th>
                                <th>Đáp án đúng</th>
                            </tr>
                        </thead>
                        <tbody>
                            <!-- Các câu hỏi sẽ được thêm vào đây -->
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary">Thêm</button>
            </div>
        </div>
    </div>
</div>




<script>
    $(document).ready(function() {
            var $chapterSelect = $('#chapterSelect');
            $('#subjectSelect').change(function() {
                var subjectId = $(this).val();
                if (subjectId) {
                    $.ajax({
                        url: '@Url.Action("GetChaptersBySubject", "Exam")',
                        type: 'GET',
                        dataType: 'json',
                        data: { subjectId: subjectId },
                        success: function(data) {
                            $chapterSelect.empty();
                            $.each(data, function(index, chapter) {
                                $chapterSelect.append('<option value="' + chapter.ID + '">' + chapter.Name + '</option>');
                            });
                            $chapterSelect.trigger('change');
                        },
                        error: function(xhr, status, error) {
                            console.log('Error: ' + error);
                        }
                    });
                } else {
                    $chapterSelect.empty();
                    $('#easyQuestions').val('');
                    $('#mediumQuestions').val('');
                    $('#hardQuestions').val('');
                }
            });
            $chapterSelect.change(function() {
                var subjectId = $('#subjectSelect').val();
                var chapterId = $(this).val();

                $.ajax({
                    url: '@Url.Action("GetQuestionCounts", "Exam")',
                    type: 'GET',
                    dataType: 'json',
                    data: { subjectId: subjectId, chapterId: chapterId },
                    success: function(data) {
                        $('#easyQuestions').val(data.easy);
                        $('#mediumQuestions').val(data.medium);
                        $('#hardQuestions').val(data.hard);
                    },
                    error: function(xhr, status, error) {
                        console.log('Error: ' + error);
                    }
                });
            });
            $('#subjectSelect').trigger('change');
    });

    // Biến lưu trữ danh sách các ID câu hỏi đã chọn
    let selectedQuestionIds = [];

    // Hàm gọi Ajax để tải danh sách câu hỏi và đánh dấu các câu hỏi đã chọn
    function generateQuestions() {
        const subjectId = document.getElementById("subjectSelect").value;
        $.ajax({
            url: '@Url.Action("GetQuestionToSubject", "Exam")',
            type: 'GET',
            data: { subId: subjectId },
            success: function (response) {
                if (response.error) {
                    alert("Có lỗi xảy ra: " + response.error);
                } else {
                    // Xóa dữ liệu cũ của DataTable nếu nó đã tồn tại
                    if ($.fn.DataTable.isDataTable('#multi-filter-select')) {
                        $('#multi-filter-select').DataTable().clear().destroy();
                    }

                    // Thêm nội dung vào `tbody` của bảng
                    let tableContent = '';
                    response.forEach(question => {
                        const isChecked = selectedQuestionIds.includes(question.Id.toString()) ? 'checked' : '';
                        tableContent += `
                            <tr>
                                <td><input type="checkbox" id="question_${question.Id}" value="${question.Id}" ${isChecked} /></td>
                                <td>${question.Id}</td>
                                <td>${question.QuestionText}</td>
                                <td>${question.Difficulty}</td>
                                <td>${question.QuestionType}</td>
                                <td>${question.CorrectAnswers}</td>
                            </tr>
                        `;
                    });
                    $('#multi-filter-select tbody').html(tableContent);

                    // Khởi tạo lại DataTable với các chức năng cần thiết
                    $('#multi-filter-select').DataTable({
                        searching: true,
                        paging: true,
                        info: true,
                        ordering: true
                    });

                    // Hiển thị modal
                    $('#questionsModal').modal('show');
                }
            },
            error: function (err) {
                console.log("Có lỗi xảy ra: ", err);
                alert("Không thể tải câu hỏi. Vui lòng thử lại.");
            }
        });
    }

    // Xử lý khi người dùng xác nhận các câu hỏi đã chọn
    document.querySelector('#questionsModal .btn-primary').addEventListener('click', function () {
        // Làm mới danh sách các câu hỏi đã chọn
        selectedQuestionIds = [];
        let selectedQuestions = [];
        document.querySelectorAll('#multi-filter-select tbody input[type="checkbox"]:checked').forEach(checkbox => {
            selectedQuestionIds.push(checkbox.value); // Lưu ID câu hỏi đã chọn
            let row = checkbox.closest('tr');
            let question = {
                IDQUESTION: checkbox.value,
                QUESTIONTEXT: row.cells[2].textContent.trim(),
                Difficulty: row.cells[3].textContent.trim(),
                QuestionType: row.cells[4].textContent.trim(),
                CorrectAnswers: row.cells[5].textContent.trim()
            };
            selectedQuestions.push(question);
        });
        displayQuestionsInTable(selectedQuestions);
        document.getElementById('questionCountLabel').textContent = `Số lượng câu hỏi đã được tạo: ${selectedQuestions.length}`;

        // Đóng modal
        $('#questionsModal').modal('hide');
    });


    function generateRandomQuestions() {
        const chapterId = document.getElementById("chapterSelect").value;
        const subjectId = document.getElementById("subjectSelect").value;
        const easyQuestionsCount = document.getElementById("easyQuestionsInput").value || 0;
        const mediumQuestionsCount = document.getElementById("mediumQuestionsInput").value || 0;
        const hardQuestionsCount = document.getElementById("hardQuestionsInput").value || 0;

        $.ajax({
            url: '@Url.Action("GetRandomQuestionsByChapterAndDifficulty", "Exam")',
            type: 'GET',
            data: {
                subId: subjectId,
                chapterId: chapterId,
                easyCount: easyQuestionsCount,
                mediumCount: mediumQuestionsCount,
                hardCount: hardQuestionsCount
            },
            success: function (response) {
                document.getElementById("questionCountLabel").innerText = `Số lượng câu hỏi đã được tạo: ${response.length}`;
                displayQuestionsInTable(response);
            },
            error: function (err) {
                console.log(err);
            }
        });
    }

    function displayQuestionsInTable(questions) {
        let questionList = document.getElementById("generatedQuestionList");
        questionList.innerHTML = '';

        let table = document.createElement("table");
        table.setAttribute("id", "questionsTable");
        table.setAttribute("class", "table table-striped table-bordered"); // Thêm lớp CSS bootstrap
        table.setAttribute("style", "text-align:center"); // Căn giữa nội dung

        let thead = document.createElement("thead");
        thead.innerHTML = `
        <tr>
            <th>Số thứ tự</th>
            <th>Độ khó</th>
            <th>Nội dung câu hỏi</th>
            <th>Đáp án đúng</th>
            <th>Loại câu hỏi</th>
        </tr>
        `;
        table.appendChild(thead);

        let tbody = document.createElement("tbody");
        questions.forEach((q, index) => {
            let row = document.createElement("tr");
            row.innerHTML = `
            <td>${q.IDQUESTION}</td>
            <td>${q.Difficulty}</td>
            <td>${q.QUESTIONTEXT}</td>
            <td>${q.CorrectAnswers}</td>
            <td>${q.QuestionType}</td>
        `;
            tbody.appendChild(row);
        });

        table.appendChild(tbody);
        questionList.appendChild(table);
        $('#questionsTable').DataTable();
    }


    function submitExam() {
        const examName = document.getElementById('nameexam').value;
        const description = document.getElementById('discribeexam').value;
        const startDate = document.getElementById('date-checkin').value;
        const endDate = document.getElementById('date-checkout').value;
        const timetoexam = document.getElementById('timetoexam').value;
        const attempts = document.getElementById('attempts').value;
        const password = document.getElementById('password').value;
        const subjectId = document.getElementById('subjectSelect').value;
        const semesterId = document.getElementById('semesterSelect').value;
        const classId = document.getElementById('classSelect').value;


        const questionIds = [];
        const table = $('#questionsTable').DataTable();
        table.rows().every(function (rowIdx, tableLoop, rowLoop) {
            const data = this.data();
            questionIds.push(data[0]);
        });


        $.ajax({
            url: '@Url.Action("CreateExam", "Exam")',
            type: 'POST',
            data: {
                examName: examName,
                description: description,
                startDate: startDate,
                endDate: endDate,
                timetoexam: timetoexam,
                attempts: attempts,
                password: password,
                subjectId: subjectId,
                semesterId: semesterId,
                classId: classId,
                questionIds: questionIds
            },
            success: function (response) {
                window.location.href = response.redirectUrl;
            },
            error: function (error) {
                console.log(error);
            }
        });
    }

</script>
