@model IEnumerable<WebThiTracNghiemOnline.Models.Class>

@{
    ViewBag.Title = "ListClass";
    Layout = "~/Areas/Admin/Views/Shared/LayoutAdmin.cshtml";
}
<div class="page-inner">
    <div class="row">
        <div class="col-md-12">
            <div class="card">
                <div class="card-header">
                    <div class="d-flex align-items-center">
                        <h4 class="card-title">Danh sách lớp học</h4>
                        <button class="btn btn-primary btn-round ms-auto" onclick="location.href='@Url.Action("CreateClass","Class")'">
                            <i class="fa fa-plus"></i>
                            Thêm mới
                        </button>
                    </div>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table id="multi-filter-select" class="table table-striped table-bordered" style="text-align:center">
                            <thead>
                                <tr>
                                    <th>Học kỳ</th>
                                    <th>Ngành nghề</th>
                                    <th>Giáo viên</th>
                                    <th>Mã lớp</th>
                                    <th>Tên lớp</th>
                                    <th>Số học sinh</th>
                                    <th>Trạng thái</th>
                                    <th>Hành động</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td>@((ViewBag.Semester as SelectList).FirstOrDefault(s => s.Value == item.IDSEMESTER.ToString())?.Text)</td>
                                        <td>@((ViewBag.Industry as SelectList).FirstOrDefault(i => i.Value == item.IDINDUSTRY.ToString())?.Text)</td>
                                        <td>@((ViewBag.Teacher as SelectList).FirstOrDefault(i => i.Value == item.IDTEACHER.ToString())?.Text)</td>
                                        <td>@Html.DisplayFor(modelItem => item.KEYCLASS)</td>
                                        <td>@Html.DisplayFor(modelItem => item.NAMECLASS)</td>
                                        <td>@ViewBag.StudentCounts[item.ID]</td>
                                        @if (item.STT == 1)
                                        {
                                            <td style="color:forestgreen">
                                                Hoạt động
                                            </td>
                                        }
                                        else
                                        {
                                            <td style="color:red">
                                                Không hoạt động
                                            </td>
                                        }
                                        <td>
                                            <button type="button" class="btn btn-success" onclick="location.href='@Url.Action("AddStudentOnClass", new { id = item.ID })'"><i class="fa fa-plus"></i></button>
                                            <button type="button" class="btn btn-primary" onclick="location.href='@Url.Action("EditClass", new { id = item.ID })'"><i class="fa fa-edit"></i></button>
                                            <button type="button" class="btn btn-info" onclick="location.href='#'"><i class="fa fa-info-circle"></i></button>
                                            <button type="button" id="xoatintucmodalt" class="btn btn-warning" onclick="confirmDelete('@Url.Action("DeleteClass", "Class", new { id = item.ID })')"><i class="fa fa-trash"></i></button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script type="text/javascript">
    function confirmDelete(deleteUrl) {
        if (confirm("Bạn có chắc chắn muốn xóa lớp học này?")) {
            $.ajax({
                url: deleteUrl,
                type: "POST",
                success: function (response) {
                    if (response.success) {
                        toastr.success(response.message);
                        setTimeout(function () {
                            location.reload();
                        }, 1500);
                    } else {
                        toastr.error(response.message);
                        setTimeout(function () {
                            location.reload();
                        }, 1500);
                    }
                },
                error: function () {
                    toastr.error("Đã xảy ra lỗi khi xóa khóa học.");
                }
            });
        }
    }
</script>



