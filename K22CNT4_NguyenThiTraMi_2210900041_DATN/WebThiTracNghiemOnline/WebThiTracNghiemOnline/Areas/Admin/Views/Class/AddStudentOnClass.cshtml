@model IEnumerable<WebThiTracNghiemOnline.Models.AccountStudents>
@{
    ViewBag.Title = "AddStudentOnClass";
    Layout = "~/Areas/Admin/Views/Shared/LayoutAdmin.cshtml";
}
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<div class="page-inner">
    <div class="row">
        <!-- Form tìm kiếm -->
        <div class="col-md-12">
            <div class="col-md-12">
                <div class="card">
                    <div class="col-md-12">
                        <div class="card-header">
                            <h4 class="card-title">Danh sách học sinh _ @ViewBag.NameClass</h4>
                        </div>
                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-6 col-lg-4">
                                    <div class="form-group row">
                                        <div class="col-9">
                                            <input type="text" class="form-control" id="studentCode" placeholder="Nhập mã sinh viên">
                                        </div>
                                        <div class="col-3">
                                            <button type="button" id="searchButton" class="btn btn-primary w-100">
                                                <i class="fas fa-search"></i> Tìm kiếm
                                            </button>
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <label for="fullName">Họ và tên:</label>
                                        <input type="text" class="form-control" id="fullName" readonly>
                                    </div>
                                    <div class="form-group row">
                                        <div class="col-6">
                                            <label for="birthYear">Năm sinh</label>
                                            <input type="datetime" class="form-control" id="birthYear" readonly>
                                        </div>
                                        <div class="col-6">
                                            <label for="gender">Giới tính</label>
                                            <input type="text" class="form-control" id="gender" readonly>
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <label for="industry">Thuộc ngành</label>
                                        <input type="text" class="form-control" id="industry" readonly>
                                    </div>
                                    <div class="form-group">
                                        <label for="email">Email</label>
                                        <input type="text" class="form-control" id="email" readonly>
                                    </div>
                                    <div class="form-group row flex-d">
                                        <div class="d-flex justify-content-between">
                                            <a class="btn btn-primary" href="@Url.Action("ListClass","Class")"><i class="fa fa-home"></i> Trở về</a>
                                            <button class="btn btn-danger" data-bs-toggle="modal" data-bs-target="#importExcelModal"><i class="fa fa-file-excel"></i> Nhập Excel</button>
                                            <button class="btn btn-success" id="btnAddStudent"><i class="fa fa-plus"></i> Thêm mới </button>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-md-6 col-lg-8">
                                    <div id="questionsTable" class="table-responsive">
                                        <table id="multi-filter-select" class="table table-striped table-bordered" style="text-align:center">
                                            <thead>
                                                <tr>
                                                    <th>Mã học sinh</th>
                                                    <th>Tên học sinh</th>
                                                    <th>Ngày sinh</th>
                                                    <th>Email</th>
                                                    <th>Hành Động</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var student in Model)
                                                {
                                                    <tr>
                                                        <td>@student.ACCOUNT</td>
                                                        <td>@student.NAMESTUDENT</td>
                                                        <td>@student.BIRTHDAY.ToString("dd/MM/yyyy")</td>
                                                        <td>@student.EMAIL</td>
                                                        <td>
                                                            <form action="@Url.Action("DeleteStudentToClass", "Class", new { idstudent = student.ID, idclass = ViewBag.ClassId })" method="post" onsubmit="return confirm('Bạn có chắc chắn muốn xóa học sinh này khỏi lớp?');">
                                                                <button type="submit" class="btn btn-warning"><i class="fa fa-trash"></i></button>
                                                            </form>
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal for Import Excel -->
<div class="modal fade" id="importExcelModal" tabindex="-1" aria-labelledby="importExcelModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="importExcelModalLabel">Nhập danh sách giảng viên từ Excel</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="importExcelForm" enctype="multipart/form-data">
                    <input type="hidden" id="classId" name="classId" value="@ViewBag.ClassId" />
                    <div class="mb-3">
                        <label for="excelFile" class="form-label">Chọn file Excel</label>
                        <input type="file" class="form-control" id="excelFile" name="excelFile" required>
                    </div>
                    <button type="submit" class="btn btn-primary">Upload</button>
                </form>
            </div>
        </div>
    </div>
</div>


<script>
    $(document).ready(function () {
        $('#importExcelForm').on('submit', function (e) {
            e.preventDefault();

            var formData = new FormData(this);
            formData.append("classId", $('#classId').val()); // Thêm classId vào FormData

            $.ajax({
                url: '@Url.Action("ImportExcel", "Class")',
                type: 'POST',
                data: formData,
                contentType: false,
                processData: false,
                success: function (response) {
                    if (response.success) {
                        toastr.success(response.message);
                        $('#importExcelModal').modal('hide');
                        setTimeout(function () {
                            location.reload();
                        }, 1500);
                    } else {
                        toastr.error(response.message);
                        setTimeout(function () {
                            location.reload();
                        }, 1500);
                    }
                },
                error: function () {
                    toastr.error("Đã xảy ra lỗi khi upload file.");
                }
            });
        });
    });

    function confirmDelete(deleteUrl) {
        if (confirm("Bạn có chắc chắn muốn xóa học sinh này khỏi lớp?")) {
            window.location.href = deleteUrl;
        }
    }

    $(document).ready(function () {
        // Xử lý khi nhấn nút tìm kiếm
        $('#searchButton').on('click', function () {
            var studentCode = $('#studentCode').val();

            // Kiểm tra nếu mã sinh viên không trống
            if (studentCode.trim() === '') {
                alert('Vui lòng nhập mã sinh viên.');
                return;
            }

            // Gửi yêu cầu AJAX đến server
            $.ajax({
                url: '@Url.Action("GetStudentInfo", "Class")',
                type: 'GET',
                data: { id: studentCode },
                success: function (data) {
                    // Cập nhật thông tin vào các ô nhập liệu
                    $('#fullName').val(data.FullName);
                    $('#birthYear').val(data.BirthYear);
                    $('#gender').val(data.Gender);
                    $('#industry').val(data.Industry);
                    $('#email').val(data.Email);
                },
                error: function () {
                    alert('Sinh viên không tồn tại. Vui lòng nhập lại!');
                }
            });
        });
    });

     $(document).ready(function () {
         $('#btnAddStudent').click(function () {
            var studentCode = $('#studentCode').val();
            var classId = @ViewBag.ClassId;

            if (studentCode) {
                $.ajax({
                    url: '@Url.Action("AddStudentToClass", "Class")',
                    type: 'POST',
                    data: { studentId: studentCode, classId: classId },
                    success: function (response) {
                        if (response.success) {
                            location.reload();
                        } else {
                            alert(response.message);
                        }
                    },
                    error: function () {
                        alert("Đã xảy ra lỗi khi thêm học sinh vào lớp.");
                    }
                });
            } else {
                alert("Vui lòng nhập mã sinh viên.");
            }
        });
    });
</script>
