@model WebThiTracNghiemOnline.Models.Subject
@{
    ViewBag.Title = "Chỉnh sửa môn học";
    Layout = "~/Areas/Admin/Views/Shared/LayoutAdmin.cshtml";
}

<div class="page-inner">
    <div class="row">
        <div class="col-md-12">
            <div class="card">
                <div class="card-body">
                    @using (Html.BeginForm("EditSubject", "Subject", FormMethod.Post, new { @class = "form-horizontal" }))
                    {
                        @Html.AntiForgeryToken()
                        <div class="form-horizontal">
                            <h2>Chỉnh sửa môn học</h2>
                            <div class="form-group">
                                @Html.LabelFor(model => model.CODE, "Mã môn học", htmlAttributes: new { @class = "control-label col-md-2" })
                                <div class="col-md-10">
                                    @Html.TextBoxFor(model => model.CODE, new { @class = "form-control" })
                                    @Html.ValidationMessageFor(model => model.CODE, "", new { @class = "text-danger" })
                                </div>
                            </div>

                            <div class="form-group">
                                @Html.LabelFor(model => model.NAMESUBJECT, "Tên môn học", htmlAttributes: new { @class = "control-label col-md-2" })
                                <div class="col-md-10">
                                    @Html.TextBoxFor(model => model.NAMESUBJECT, new { @class = "form-control" })
                                    @Html.ValidationMessageFor(model => model.NAMESUBJECT, "", new { @class = "text-danger" })
                                </div>
                            </div>

                            <div class="form-group">
                                @Html.LabelFor(model => model.DESCRIBE, "Mô tả", htmlAttributes: new { @class = "control-label col-md-2" })
                                <div class="col-md-10">
                                    @Html.TextAreaFor(model => model.DESCRIBE, new { @class = "form-control", rows = 3 })
                                    @Html.ValidationMessageFor(model => model.DESCRIBE, "", new { @class = "text-danger" })
                                </div>
                            </div>

                            <div class="form-group">
                                @Html.LabelFor(model => model.TINCHI, "Số tín chỉ", htmlAttributes: new { @class = "control-label col-md-2" })
                                <div class="col-md-10">
                                    @Html.TextBoxFor(model => model.TINCHI, new { @class = "form-control" })
                                    @Html.ValidationMessageFor(model => model.TINCHI, "", new { @class = "text-danger" })
                                </div>
                            </div>

                            <div class="form-group">
                                @Html.LabelFor(model => model.IDSEMESTER, "Học kỳ", htmlAttributes: new { @class = "control-label col-md-2" })
                                <div class="col-md-10">
                                    @Html.DropDownListFor(model => model.IDSEMESTER, (SelectList)ViewBag.Semester, "Chọn học kỳ", new { @class = "form-control" })
                                    @Html.ValidationMessageFor(model => model.IDSEMESTER, "", new { @class = "text-danger" })
                                </div>
                            </div>

                            <div class="form-group">
                                <div class="col-md-offset-2 col-md-10">
                                    <input type="submit" value="Lưu thay đổi" class="btn btn-primary btn-round" />
                                    <a class="btn btn-warning btn-round" href="@Url.Action("ListSubject", "Subject")">Hủy</a>
                                </div>
                            </div>
                        </div>
                    }
                    @if (ViewBag.ErrorMessage != null)
                    {
                        <div class="alert alert-danger">
                            @ViewBag.ErrorMessage
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>


