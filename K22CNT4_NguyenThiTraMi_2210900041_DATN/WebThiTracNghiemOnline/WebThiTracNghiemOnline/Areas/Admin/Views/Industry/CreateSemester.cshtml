
@model WebThiTracNghiemOnline.Models.Semester

@{
    ViewBag.Title = "CreateSemester";
    Layout = "~/Areas/Admin/Views/Shared/LayoutAdmin.cshtml";
}

<div class="page-inner">
    <div class="row">
        <div class="col-md-12">
            <div class="card">
                <div class="card-body">
                    @using (Html.BeginForm("CreateSemester", "Industry", FormMethod.Post, new { enctype = "multipart/form-data" }))
                    {
                        @Html.AntiForgeryToken()
                        <div class="form-horizontal">
                            <h4>Tạo học kỳ mới</h4>
                            <hr />
                            @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                            <div class="form-group">
                                <label for="COURSEID" class="control-label col-md-2">Chọn khóa học</label>
                                <div class="col-md-10">
                                    @Html.DropDownList("COURSEID", (SelectList)ViewBag.Course, "Chọn khóa học", new { @class = "form-control" })
                                    @Html.ValidationMessage("COURSEID", "", new { @class = "text-danger" })
                                </div>
                            </div>

                            <div class="form-group">
                                <label for="NAMESEMESTER" class="control-label col-md-2">Tên học kỳ</label>
                                <div class="col-md-10">
                                    <input type="text" name="NAMESEMESTER" class="form-control" />
                                    @Html.ValidationMessage("NAMESEMESTER", "", new { @class = "text-danger" })
                                </div>
                            </div>

                            <div class="form-group">
                                <label for="STARTDAY" class="control-label col-md-2">Ngày bắt đầu</label>
                                <div class="col-md-10">
                                    <input type="date" name="STARTDAY" class="form-control" />
                                    @Html.ValidationMessage("STARTDAY", "", new { @class = "text-danger" })
                                </div>
                            </div>

                            <div class="form-group">
                                <label for="ENDDAY" class="control-label col-md-2">Ngày kết thúc</label>
                                <div class="col-md-10">
                                    <input type="date" name="ENDDAY" class="form-control" />
                                    @Html.ValidationMessage("ENDDAY", "", new { @class = "text-danger" })
                                </div>
                            </div>

                            <div class="form-group">
                                <div class="col-md-offset-2 col-md-10">
                                    <input type="submit" value="Thêm mới" class="btn btn-primary btn-round ms-auto" />
                                    <a class="btn btn-warning btn-round ms-auto" href="@Url.Action("ListSemester", "Industry")">Trở về</a>
                                </div>
                            </div>
                        </div>
                    }
                    @if (ViewBag.ErrorMessage != null)
                    {
                        <div class="alert alert-danger">
                            @ViewBag.ErrorMessage
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>




