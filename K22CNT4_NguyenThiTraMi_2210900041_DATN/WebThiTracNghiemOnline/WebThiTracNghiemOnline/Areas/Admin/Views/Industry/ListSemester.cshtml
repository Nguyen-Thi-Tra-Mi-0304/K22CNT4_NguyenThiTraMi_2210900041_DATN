@model IEnumerable<WebThiTracNghiemOnline.Models.Semester>

@{
    ViewBag.Title = "ListSemester";
    Layout = "~/Areas/Admin/Views/Shared/LayoutAdmin.cshtml";
}
<div class="page-inner">
    <div class="row">
        <div class="col-md-12">
            <div class="card">
                <div class="card-header">
                    <div class="d-flex align-items-center">
                        <h4 class="card-title">Danh sách học kỳ</h4>
                        <button class="btn btn-primary btn-round ms-auto" onclick="location.href='@Url.Action("CreateSemester","Industry")'">
                            <i class="fa fa-plus"></i>
                            Thêm mới
                        </button>
                    </div>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table id="multi-filter-select" class="table table-striped table-bordered" style="text-align:center">
                            <thead>
                                <tr role="row">
                                    <th>
                                        Tên khóa
                                    </th>
                                    <th>
                                        Tên học kỳ
                                    </th>
                                    <th>
                                        Ngày bắt đầu
                                    </th>
                                    <th>
                                        Ngày kết thúc
                                    </th>
                                    <th>
                                        Trạng thái
                                    </th>
                                    <th>
                                        Hành động
                                    </th>
                                </tr>
                                </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td>@((ViewBag.Course as SelectList).FirstOrDefault(s => s.Value == item.COURSEID.ToString())?.Text)</td>
                                        <td>
                                            @Html.DisplayFor(modelItem => item.NAMESEMESTER)
                                        </td>
                                        <td>
                                            @Html.DisplayFor(modelItem => item.STARTDAY)
                                        </td>
                                        <td>
                                            @Html.DisplayFor(modelItem => item.ENDDAY)
                                        </td>
                                        @if (item.STT == 1)
                                        {
                                            <td style="color:forestgreen">
                                                Hoạt động
                                            </td>
                                        }
                                        else
                                        {
                                            <td style="color:red">
                                                Không hoạt động
                                            </td>
                                        }
                                        <td>
                                            <button type="button" class="btn btn-primary" onclick="location.href='@Url.Action("EditSemester", new { id = item.ID })'"><i class="fa fa-edit"></i></button>
                                            <button type="button" class="btn btn-info" onclick="location.href='#"><i class="fa fa-info-circle"></i></button>
                                            <button type="button" id="xoatintucmodalt" class="btn btn-warning" onclick="confirmDelete('@Url.Action("DeleteSemester", "Industry", new { id = item.ID })')"><i class="fa fa-trash"></i></button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script type="text/javascript">
    function confirmDelete(deleteUrl) {
        if (confirm("Bạn có chắc chắn muốn xóa học kỳ này?")) {
            $.ajax({
                url: deleteUrl,
                type: "POST",
                success: function (response) {
                    if (response.success) {
                        toastr.success(response.message);
                        setTimeout(function () {
                            location.reload();
                        }, 1500);
                    } else {
                        toastr.error(response.message);
                        setTimeout(function () {
                            location.reload();
                        }, 1500);
                    }
                },
                error: function () {
                    toastr.error("Đã xảy ra lỗi khi xóa học kỳ này.");
                }
            });
        }
    }
</script>