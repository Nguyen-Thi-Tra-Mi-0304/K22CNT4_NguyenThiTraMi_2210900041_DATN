
@{
    ViewBag.Title = "ChangePassword";
    Layout = "~/Areas/Admin/Views/Shared/LayoutAdmin.cshtml";
}


<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h3 class="text-center">Đặt lại mật khẩu</h3>
                </div>
                <div class="card-body">
                    @using (Html.BeginForm("ChangePassword", "HomePage", FormMethod.Post, new { @class = "form-horizontal" }))
                    {
                        @Html.AntiForgeryToken()

                        <!-- Mật khẩu hiện tại -->
                        <div class="mb-3">
                            @Html.Label("Mật khẩu hiện tại", new { @class = "form-label" })
                            @Html.Password("oldPassword", null, new { @class = "form-control", placeholder = "Nhập mật khẩu hiện tại", required = "required" })
                        </div>

                        <!-- Mật khẩu mới -->
                        <div class="mb-3">
                            @Html.Label("Mật khẩu mới", new { @class = "form-label" })
                            @Html.Password("newPassword", null, new { @class = "form-control", placeholder = "Nhập mật khẩu mới", required = "required" })
                        </div>

                        <!-- Nhập lại mật khẩu mới -->
                        <div class="mb-3">
                            @Html.Label("Xác nhận mật khẩu mới", new { @class = "form-label" })
                            @Html.Password("confirmPassword", null, new { @class = "form-control", placeholder = "Nhập lại mật khẩu mới", required = "required" })
                        </div>

                        <!-- Nút submit -->
                        <div class="d-grid">
                            <button type="submit" class="btn btn-success">
                                Đặt lại mật khẩu
                            </button>
                        </div>

                        <!-- Thông báo lỗi -->
                        if (!String.IsNullOrEmpty(ViewBag.ErrorMessage))
                        {
                            <div class="alert alert-danger mt-3" role="alert">
                                @ViewBag.ErrorMessage
                            </div>
                        }

                        <!-- Thông báo thành công -->
                        if (!String.IsNullOrEmpty(ViewBag.Message))
                        {
                            <div class="alert alert-success mt-3" role="alert">
                                @ViewBag.Message
                            </div>
                        }
                    }
                </div>
            </div>
        </div>
    </div>
</div>





