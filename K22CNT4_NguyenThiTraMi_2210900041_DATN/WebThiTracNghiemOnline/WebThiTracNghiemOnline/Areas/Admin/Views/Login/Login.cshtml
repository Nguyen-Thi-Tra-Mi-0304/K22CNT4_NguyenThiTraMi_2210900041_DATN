<!doctype html>
<html lang="en">
<head>
    <!-- Required meta tags -->
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <link href="https://fonts.googleapis.com/css?family=Roboto:300,400&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="~/Areas/Admin/Data/DataLogin/fonts/icomoon/style.css">

    <link rel="stylesheet" href="~/Areas/Admin/Data/DataLogin/css/owl.carousel.min.css">

    <!-- Bootstrap CSS -->
    <link rel="stylesheet" href="~/Areas/Admin/Data/DataLogin/css/bootstrap.min.css">

    <!-- Style -->
    <link rel="stylesheet" href="~/Areas/Admin/Data/DataLogin/css/style.css">

    <title>Đăng nhập</title>
</head>
<body>
    <div class="half">
        <div class="bg order-1 order-md-2" style="background-image: url('/Areas/Admin/Data/DataLogin/images/imgtruong.jpg');"></div>
        <div class="contents order-2 order-md-1">
            <div class="container">
                <div class="row align-items-center justify-content-center">
                    <div class="col-md-6">
                        <div class="form-block">
                            <div class="text-center mb-5">
                                <h3>Đăng nhập vào hệ thống</h3>
                            </div>
                            @using (Html.BeginForm("Login_Account", "Login", FormMethod.Post, new { @class = "form-horizontal" }))
                            {
                                @Html.AntiForgeryToken() 

                                <div class="form-group first">
                                    <label for="username">Tên tài khoản</label>
                                    <input type="text" value="admin" class="form-control" placeholder="Tài khoản..." name="username" id="username" required>
                                </div>
                                <div class="form-group last mb-3">
                                    <label for="password">Mật khẩu</label>
                                    <input type="password" value="123456" class="form-control" placeholder="Mật khẩu..." name="password" id="password" required>
                                </div>

                                <div class="d-sm-flex mb-5 align-items-center">
                                    <span class="ml-auto"><a href="#" class="forgot-pass">Quên mật khẩu?</a></span>
                                </div>

                                <input type="submit" value="Đăng nhập" class="btn btn-block btn-primary">
                                if (!String.IsNullOrEmpty(ViewBag.ErrorMessage))
                                {
                                    <div class="alert alert-danger mt-3">@ViewBag.ErrorMessage</div>
                                }
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>


    <script src="~/Areas/Admin/Data/DataLogin/js/jquery-3.3.1.min.js"></script>
    <script src="~/Areas/Admin/Data/DataLogin/js/popper.min.js"></script>
    <script src="~/Areas/Admin/Data/DataLogin/js/bootstrap.min.js"></script>
    <script src="~/Areas/Admin/Data/DataLogin/js/main.js"></script>
</body>
</html>