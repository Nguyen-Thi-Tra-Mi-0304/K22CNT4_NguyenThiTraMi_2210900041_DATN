    function submitQuestion1() {
    const selectedChapterId = $('#chapterSelect').val();
    const questionTextElement = document.getElementById("questions");
    const questionText = questionTextElement.value.trim();
    const difficultyElement = document.querySelector('input[name="difficulty"]:checked');

    if (!selectedChapterId) {
        alert("Vui lòng chọn chương.");
        return;
    }

    if (!questionText) {
        alert("Vui lòng nhập nội dung câu hỏi.");
        return;
    }

    if (!difficultyElement) {
        alert("Vui lòng chọn độ khó.");
        return;
    }

    const difficulty = difficultyElement.value;
    const answers = [];
    let allAnswersFilled = true;

    // Duyệt qua từng đáp án
    for (let i = 1; i <= 4; i++) {
        const answerElement = document.getElementById(`answer${i}`);
        const checkboxElement = document.querySelector(`input[type="checkbox"][data-answer="${String.fromCharCode(64 + i)}"]`);
        const answerText = answerElement.value.trim();

        if (!answerText) {
            allAnswersFilled = false; // Nếu đáp án không được điền
        }

        const isCorrect = checkboxElement.checked;

        answers.push({
            ANSWERTEXT: answerText,
            ISCORRECT: isCorrect,
            ANSWERTYPE: 1,
            BLANKPOSITION: 0
        });
    }

    // Kiểm tra xem ít nhất một đáp án phải được điền
    if (!allAnswersFilled) {
        alert("Vui lòng điền đầy đủ các đáp án.");
        return;
    }

    // Kiểm tra xem ít nhất một đáp án phải được chọn là đúng
    const hasCorrectAnswer = answers.some(answer => answer.ISCORRECT);
    if (!hasCorrectAnswer) {
        alert("Vui lòng chọn ít nhất một đáp án đúng.");
        return;
    }

    // Chuẩn bị dữ liệu câu hỏi để gửi
    const questionData = {
        IDCHAPTER: selectedChapterId,
        QUESTIONTEXT: questionText,
        QUESTIONTYPE: 1,
        DIFFICULTY: difficulty
    };

    // Gửi dữ liệu qua AJAX
    $.ajax({
        url: '@Url.Action("SaveQuestionAndAnswers", "Questions")',
        type: 'POST',
        data: JSON.stringify({ question: questionData, answers: answers }),
        contentType: 'application/json; charset=utf-8',
        dataType: 'json',
        success: function(response) {
            if (response.success) {
                toastr.success('Câu hỏi và đáp án đã được lưu thành công!', '', { timeOut: 2000 });
                searchQuestions();
            } else {
                alert("Có lỗi xảy ra: " + response.message);
            }
        },
        error: function(xhr, status, error) {
            alert("Có lỗi xảy ra: " + error);
        }
    });
}
</script>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        const fillInBlankQuestion = document.getElementById('fillInBlankQuestion');
        const fillInBlankDisplay = document.getElementById('fillInBlankDisplay');
        const answerContainer = document.getElementById('answer-container');
        const addAnswerButton = document.getElementById('add-answer');

        function updateDisplay() {
            const questionText = fillInBlankQuestion.value;
            const parts = questionText.split('(_)');
            const fragment = document.createDocumentFragment();

            parts.forEach((part, index) => {
                fragment.appendChild(document.createTextNode(part));
                if (index < parts.length - 1) {
                    const input = document.createElement('input');
                    input.type = 'text';
                    input.className = 'form-control answer-input';
                    input.placeholder = 'Nhập đáp án';
                    fragment.appendChild(input);
                }
            });

            fillInBlankDisplay.innerHTML = '';
            fillInBlankDisplay.appendChild(fragment);
            updateAnswerFields();
        }

        function updateAnswerFields() {
            const answerInputs = fillInBlankDisplay.querySelectorAll('.answer-input');
            const existingAnswerGroups = answerContainer.querySelectorAll('.input-group'); answer - input
            const fragment = document.createDocumentFragment();

            existingAnswerGroups.forEach((group, index) => {
                group.style.display = index < answerInputs.length ? 'flex' : 'none';
            });

            for (let i = existingAnswerGroups.length; i < answerInputs.length; i++) {
                fragment.appendChild(createAnswerGroup(i + 1));
            }

            answerContainer.appendChild(fragment);
        }

        function createAnswerGroup(index) {
            const div = document.createElement('div');
            div.className = 'input-group mb-2';
            div.innerHTML = `
            <input type="text" class="form-control" name="blankAnswer[]" placeholder="Nhập đáp án cho chỗ trống ${index}">
            <button type="button" class="btn btn-danger remove-answer">Xóa</button>
        `;
            return div;
        }

        function handleAnswerContainerClick(e) {
            if (e.target.classList.contains('remove-answer')) {
                if (confirm('Bạn có chắc chắn muốn xóa đáp án này?')) {
                    e.target.parentElement.remove();
                    updateAnswerFields();
                }
            }
        }

        function handleAddAnswerButtonClick() {
            const totalAnswers = answerContainer.querySelectorAll('.input-group').length;
            answerContainer.appendChild(createAnswerGroup(totalAnswers + 1));
            updateAnswerFields();
        }

        fillInBlankQuestion.addEventListener('input', updateDisplay);
        answerContainer.addEventListener('click', handleAnswerContainerClick);
        addAnswerButton.addEventListener('click', handleAddAnswerButtonClick);
        updateAnswerFields();
    });

    function submitFillInBlankQuestion() {
    const selectedChapterId = $('#chapterSelect').val();
    const questionText = document.getElementById('fillInBlankQuestion').value;
    const difficulty = document.querySelector('input[name="difficulty-fillInBlank"]:checked').value;
        if (!selectedChapterId) {
            alert("Vui lòng chọn chương.");
            return;
        }

        if (!questionText) {
            alert("Vui lòng nhập nội dung câu hỏi.");
            return;
        }

        if (!difficulty) {
            alert("Vui lòng chọn độ khó.");
            return;
        }
    // Lấy thông tin đáp án từ các ô input
    const answerInputs = document.querySelectorAll('.answer-input');
    const answers = [];
    answerInputs.forEach((input, index) => {
        if (input.value.trim() !== '') {
            answers.push({
                ANSWERTEXT: input.value,
                ISCORRECT: true,
                ANSWERTYPE: 3,
                BLANKPOSITION: index + 1
            });
        }
    });

    // Kiểm tra điều kiện trước khi gửi
    if (questionText.trim() === '' || answers.length === 0) {
        alert("Vui lòng nhập đầy đủ câu hỏi và ít nhất một đáp án.");
        return;
    }

    // Tạo đối tượng dữ liệu câu hỏi
        const questionData = {
            IDCHAPTER: selectedChapterId,
            QUESTIONTEXT: questionText,
            QUESTIONTYPE: 3,
            DIFFICULTY: difficulty,
    };

    // Gửi yêu cầu AJAX
    $.ajax({
        type: 'POST',
        url: '@Url.Action("SaveFillInBlankQuestion", "Questions")', // Đường dẫn tới action trên server
        data: JSON.stringify({ question: questionData, answers: answers }),
        contentType: 'application/json; charset=utf-8',
        dataType: 'json',
        success: function (response) {
            if (response.success) {
                toastr.success('Câu hỏi và đáp án đã được lưu thành công!', '', { timeOut: 2000 });
                document.getElementById('fillInBlankQuestion').value = ''; // Xóa nội dung câu hỏi
                searchQuestions();
            } else {
                toastr.error('Đã có lỗi xảy ra: ' + response.message);
            }
        },
        error: function (xhr, status, error) {
            toastr.error('Đã có lỗi xảy ra: ' + error);
        }
    });
}

</script>

<script>
    $(document).ready(function () {
        $.ajax({
            url: '@Url.Action("GetSubjects", "Questions")',
            type: 'GET',
            dataType: 'json',
            success: function (data) {
                var $subjectSelect = $('#subjectSelect');
                $subjectSelect.empty();
                $subjectSelect.append('<option value="" disabled selected hidden>Chọn môn học</option>');
                $.each(data, function (index, subject) {
                    $subjectSelect.append('<option value="' + subject.ID + '">' +
                        subject.SubjectID + ' - ' + subject.SubjectName + ' (Học kỳ: ' + subject.SemesterName + ')</option>');
                });
            },
            error: function (xhr, status, error) {
                console.error('Có lỗi xảy ra: ', error);
            }
        });
    });

    $(document).ready(function () {
        $('#subjectSelect').change(function () {
            var selectedSubjectId = $(this).val();
            $.ajax({
               url: '@Url.Action("GetChaptersToSubjects", "Questions")',
                type: 'GET',
                data: { subjectId: selectedSubjectId },
                dataType: 'JSON',
                success: function (data) {
                    var $chapterSelect = $('#chapterSelect');
                    $chapterSelect.empty();

                    $chapterSelect.append('<option value="" disabled selected hidden>Chọn chương</option>');
                    $.each(data, function (index, chapter) {
                        $chapterSelect.append('<option value="' + chapter.ChapterID + '">' +
                            chapter.ChapterName + '</option>');
                    });
                },
                error: function (xhr, status, error) {
                    console.error('Có lỗi xảy ra: ', error);
                }
            });
        });
    });

    // Loc cau hoi theo chương
    function searchQuestions() {
    var selectedChapterId = $('#chapterSelect').val();

    if (!selectedChapterId) {
        alert("Vui lòng chọn chương.");
        return;
    }

    $.ajax({
        url: '@Url.Action("GetQuestionsByChapter", "Questions")',
        type: 'GET',
        data: { chapterId: selectedChapterId },
        dataType: 'json',
        success: function (data) {
            var $questionsTable = $('#multi-filter-select'); // Bảng DataTable
            var $questionsTableBody = $questionsTable.find('tbody');

            // Hủy khởi tạo DataTable nếu đã khởi tạo trước đó
            if ($.fn.DataTable.isDataTable($questionsTable)) {
                $questionsTable.DataTable().clear().destroy();
            }

            // Xóa nội dung cũ
            $questionsTableBody.empty();

            if (data.length === 0) {
                $questionsTableBody.append('<tr><td colspan="6">Không tìm thấy câu hỏi nào.</td></tr>');
            } else {
                $.each(data, function (index, question) {
                    var correctAnswers = question.CorrectAnswers.join('  ||  ');

                    var row = '<tr>' +
                        '<td>' + question.IDQUESTION + '</td>' +
                        '<td>' + question.QUESTIONTEXT + '</td>' +
                        '<td>' + correctAnswers + '</td>' +
                        '<td>' + question.QUESTIONTYPE + '</td>' +
                        '<td>' + question.DIFFICULTY + '</td>' +
                        '<td>';

                    // Kiểm tra NOEDIT
                    if (question.NOEDIT == 1) {
                        row += '<button class="btn btn-primary btn-sm" onclick="showNoEditMessage()">Sửa</button> ';
                    } else {
                        // Kiểm tra loại câu hỏi và thêm nút sửa tương ứng
                        if (question.QUESTIONTYPE == 'single-choice') {
                            row += '<button class="btn btn-primary btn-sm" onclick="editQuestionType1(' + question.IDQUESTION + ')">Sửa</button> ';
                        } else if (question.QUESTIONTYPE == 'multiple-choice') {
                            row += '<button class="btn btn-primary btn-sm" onclick="editQuestionType2(' + question.IDQUESTION + ')">Sửa</button> ';
                        } else if (question.QUESTIONTYPE == 'fill-in-the-blank') {
                            row += '<button class="btn btn-primary btn-sm" onclick="editQuestionType3(' + question.IDQUESTION + ')">Sửa</button> ';
                        }
                    }

                    // Nút xóa
                    row += '<button class="btn btn-danger btn-sm" onclick="deleteQuestion(' + question.IDQUESTION + ')">Xóa</button>' +
                        '</td>' +
                        '</tr>';

                    $questionsTableBody.append(row);
                });
            }
        },
        error: function (xhr, status, error) {
            console.error('Có lỗi xảy ra: ', error);
            alert("Có lỗi xảy ra: " + error);
        }
    });
}


    function showNoEditMessage() {
        // Hiển thị thông báo với toastr khi không thể sửa câu hỏi
        toastr.warning('Câu hỏi này không thể chỉnh sửa khi đang trong quá trình thi.', 'Thông báo');
    }

    function deleteQuestion(id) {
    if (confirm("Bạn có chắc chắn muốn xóa câu hỏi này không?")) {
        $.ajax({
            url: '@Url.Action("DeleteQuestion", "Questions")',
            type: 'POST',
            data: { id: id },
            dataType: 'json',
            success: function(response) {
                if (response.success) {
                    toastr.success('Câu hỏi đã được xóa thành công!', '', { timeOut: 1500 });
                    searchQuestions(); // Tải lại danh sách câu hỏi
                } else {
                    alert("Có lỗi xảy ra: " + response.message);
                }
            },
            error: function(xhr, status, error) {
                console.error('Có lỗi xảy ra khi xóa câu hỏi: ', error);
                alert("Có lỗi xảy ra khi xóa câu hỏi: " + error);
            }
        });
    }
}

    // Lay ket qua vao input hidden
    document.addEventListener("DOMContentLoaded", function () {
        const checkboxes = document.querySelectorAll('.checkbox-button');
        const hiddenInput = document.getElementById('selectedAnswer');

        checkboxes.forEach(function (checkbox) {
            checkbox.addEventListener('click', function () {
                checkboxes.forEach(function (cb) {
                    if (cb !== checkbox) {
                        cb.checked = false;
                    }
                });
                if (checkbox.checked) {
                    const answerInput = checkbox.nextElementSibling;
                    hiddenInput.value = answerInput.value;
                } else {
                    hiddenInput.value = '';
                }
            });
        });
    });




</script>