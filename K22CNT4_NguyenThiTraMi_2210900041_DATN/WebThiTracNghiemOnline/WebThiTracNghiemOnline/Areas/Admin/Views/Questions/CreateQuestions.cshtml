<script>
    function editQuestionType1(questionId) {
        $.ajax({
            url: '/Questions/GetQuestionDetails1',
            type: 'GET',
            data: { id: questionId },
            dataType: 'json',
            success: function (response) {
                if (response.success) {
                    const questionData = response.data;
                    $('#questionsType1').val(questionData.QUESTIONTEXT);
                    $('#editQuestionModalType1').data('question-id', questionId);

                    const answers = questionData.Answers;
                    answers.forEach((answer, index) => {
                        const answerInput = $(`#answer${index + 1}Type1`);
                        const checkboxInput = $(`.checkbox-button[data-answer="${String.fromCharCode(65 + index)}"]`);

                        answerInput.val(answer.ANSWERTEXT);
