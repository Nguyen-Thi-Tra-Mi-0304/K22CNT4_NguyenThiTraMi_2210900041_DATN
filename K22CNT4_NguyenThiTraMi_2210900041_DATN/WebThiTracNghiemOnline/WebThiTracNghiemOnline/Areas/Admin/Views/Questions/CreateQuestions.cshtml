                                <span class="selectgroup-button">Trung Bình</span>
                            </label>
                            <label class="selectgroup-item">
                                <input type="radio" name="DIFFICULTY" value="3" class="selectgroup-input">
                                <span class="selectgroup-button">Khó</span>
                            </label>
                        </div>
                    </div>

                    <!-- Answers -->
                    <div class="form-group">
                        <label for="editAnswers">Danh sách đáp án</label>
                        <div id="editFillInBlankAnswers">
                            <!-- Dynamic inputs for answers will be added here -->
                        </div>
                    </div>
                </form>
